#!/bin/sh

. /opt/apps/kvas/bin/libs/main
_KL_main=1
_require(){ for _l in "$@"; do eval "[ -n \"\${_KL_$_l}\" ]" && continue; if [ -f "/opt/apps/kvas/bin/libs/$_l" ]; then . "/opt/apps/kvas/bin/libs/$_l"; else . "/opt/apps/kvas/bin/main/$_l"; fi; eval "_KL_$_l=1"; done; }

#------------------------------------------------------------------------------
#
#	ПАКЕТ КВАС
#	файл ./kvas/bin/kvas -> /opt/bin/kvas
#
#------------------------------------------------------------------------------
#
#	Данный файл служит для запуска пакета КВАС из командной строки
#	и содержит основные команды запуска пакета:
#	Обработка получаемых аргументов скрипта
#	$1 - команда для обработки
#	$2 - аргумент для работы команды
#
# ------------------------------------------------------------------------------
#	Разработчик: mail@zeleza.ru
#	Дата создания: 21/05/2022
#	Лицензия: Apache License 2.0
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------------------
#
#	Функция оторажения списка доменных имен и поиска доменного имени
#	$1 - строка поиска
# ------------------------------------------------------------------------------------------
cmd_show_kvas_list(){

	local domain_to_search="${1}"
	if [ -z "${domain_to_search}" ] ; then
		cmd_show_list
	else
		cmd_show_list | grep "${domain_to_search}" || {
			echo -e "Доменное имя ${BLUE}${domain_to_search}${NOCL} в списке не обнаружено."
		}
	fi
}

if  echo "${1}" | grep -qvEi 'uninstall|hysteria|failover|vpn|route|monitor|ver|help' && [ -z "$(get_config_value "SETUP_FINISHED")" ]; then
	print_line
	echo "${2}" | grep -qE 'upgrade|true' && warning "Запускаем настройку пакета" || {
		error "Настройка пакета не завершена, запускаем настройку пакета" "1"
		print_line
	}
	_require setup vpn vless route check monitor hosts
	cmd_install "${2}"
	print_line
	exit 0
fi

#clear_file_content "${KVAS_LIST_FILE}"

# lazy-load: подгружаем библиотеки по команде
case "${1}" in
	setup|uninstall|pause|freeze|unpause|unfreeze) _require setup vpn vless route check monitor hosts ;;
	show|list|search|find|purge|clear|import|export) _require vpn ;;
	add|new|del|rm) _require vpn ;;
	backup) : ;;
	restore) _require vpn ;;
	tags|add_tags|del_tags) _require tags vpn ;;
 	vless) _require vless vpn ;;
 	awg) _require awg ;;
 	xray) _require vless ;;
 	hysteria) _require hysteria vpn ;;
	failover) _require failover ;;
	ssr|vpn|dns|dnsmasq|dnscrypt|crypt|adblock|ads|adguard) _require vpn update check ;;
	hosts) _require hosts ;;
	tunnel|route) _require route vpn ;;
	log|syslog) _require debug ;;
	ipset) _require debug ;;
	debug) _require debug vpn route hysteria ;;
	monitor|monitoring) _require monitor vpn ;;
	test|check) _require check ;;
	reset|init) _require vpn ;;
	version|ver) : ;;
	help|-h|--h|"") _require vpn ;;
	upgrade|update|rollback) : ;;
	*) _require vpn ;;
esac
print_line
case "${1}" in
	setup)
							cmd_install "${2}"
							echo "Настройка пакета КВАС завершена!"
							echo "Для удаления пакета наберите 'kvas uninstall'"
							;;

	# Работа со списком

	show | list | search | find)
							cmd_show_kvas_list "${2}"
		;;
	purge | clear)			cmd_clear_list "${2}"
		;;

	import)					cmd_import_hosts "${2}"
		;;
	export)					cmd_export_hosts "${2}"
		;;

	add | new)
		if [ "$2" = "tags" ]; then
			shift 2
			tag="${1:-}"
			if [ -z "$tag" ]; then
				add_tag_section_to_protect_list
			else
				cmd_add_tag_section_to_protect_list_noninteractive "$tag"
			fi
			exit 0
		fi
		_wild=""
		_skip_first=1
		_added=false
		for _arg; do
			[ -n "$_skip_first" ] && { _skip_first=; continue; }
			case "$_arg" in
				-w|--wildcard|--wild) _wild="yes" ;;
				*) _domains="$_domains${_domains:+ }$_arg" ;;
			esac
		done
		[ -z "$_wild" ] && [ $# -eq 3 ] && echo "${3}" | grep -qiE '^yes$|^y$|^wild$' && _wild="yes" && _domains="${2}"
		for _dom in $_domains; do
			[ -n "$_dom" ] && cmd_add_one_host "$_dom" "no" "$_wild" && _added=true
		done
		if $_added; then
			update_ipset refresh &>/dev/null
			if [ -f /opt/etc/init.d/S56dnsmasq ]; then
				/opt/etc/init.d/S56dnsmasq restart &>/dev/null
			else
				/opt/etc/init.d/S99adguardhome restart &>/dev/null
			fi
			for _dom in $_domains; do
				[ -n "$_dom" ] && ipset__fill_by_domain "$_dom" &>/dev/null
			done
		fi
		;;
	del | rm  )
		if [ "$2" = "tags" ]; then
			shift 2
			tag="${1:-}"
			if [ -z "$tag" ]; then
				del_tag_section_to_protect_list
			else
				cmd_del_tag_section_from_protect_list_noninteractive "$tag"
			fi
			exit 0
		fi
		_skip_first=1
		_deleted=false
		for _arg; do
			[ -n "$_skip_first" ] && { _skip_first=; continue; }
			_domains="$_domains${_domains:+ }$_arg"
		done
		for _dom in $_domains; do
			[ -z "$_dom" ] && continue
			ready "Удаляем $_dom из списка защищенных..."
			_esc_dom=$(echo "$_dom" | sed 's/\//\\\//g')
			if grep -qe "${_dom}$" "$KVAS_LIST_FILE" 2>/dev/null; then
				sed -i "/${_esc_dom}/d" "$KVAS_LIST_FILE" 2>/dev/null
				cmd_adguardhome_status | grep -q ВКЛЮЧЕН 2>/dev/null && sed -i "/${_esc_dom}/d" "$ADGUARD_IPSET_FILE" 2>/dev/null
				for _ip in $(dns__get_ips_by_domain "$_dom" 2>/dev/null); do
					/opt/sbin/ipset -exist del "${IPSET_TABLE_NAME}" "$_ip" &>/dev/null
				done
				_deleted=true
				when_ok "УДАЛЕН"
			else
				when_bad "НЕТ В СПИСКЕ"
			fi
		done
		if $_deleted; then
			update_ipset refresh &>/dev/null
			if [ -f /opt/etc/init.d/S56dnsmasq ]; then
				/opt/etc/init.d/S56dnsmasq restart &>/dev/null
			else
				/opt/etc/init.d/S99adguardhome restart &>/dev/null
			fi
		fi
		;;

	backup)
		BKPDIR="/opt/kvas_backup_$(date +%Y%m%d-%H%M%S)"
		mkdir -p "$BKPDIR"
		cp -f "$KVAS_LIST_FILE" "$BKPDIR/" 2>/dev/null
		cp -f "$TAGS_LIST_FILE" "$BKPDIR/" 2>/dev/null
		cp -f "$KVAS_CONF_FILE" "$BKPDIR/" 2>/dev/null
		cp -f "$HYSTERIA_CONFIG" "$BKPDIR/" 2>/dev/null
		cp -f "$HYSTERIA_ENV_FILE" "$BKPDIR/" 2>/dev/null
		cp -f "$SHADOWSOCKS_CONF" "$BKPDIR/" 2>/dev/null
		cp -f "$DNSMASQ_CONFIG" "$BKPDIR/" 2>/dev/null
		cp -f "$DNSMASQ_IPSET_HOSTS" "$BKPDIR/" 2>/dev/null
		cp -f "$DNSCRYPT_CONFIG" "$BKPDIR/" 2>/dev/null
		cp -f "$ADGUARDHOME_CONFIG" "$BKPDIR/" 2>/dev/null
		cp -f "$ADGUARD_IPSET_FILE" "$BKPDIR/" 2>/dev/null
		cp -f "$VLESS_CONFIG_FILE" "$BKPDIR/" 2>/dev/null
		[ -f "$KVAS_WEB_PASS" ] && cp -f "$KVAS_WEB_PASS" "$BKPDIR/" 2>/dev/null
		[ -f /opt/apps/kvas/hysteria/bin/hysteria ] && cp -f /opt/apps/kvas/hysteria/bin/hysteria "$BKPDIR/hysteria"
		[ -f /opt/sbin/xray ] && cp -f /opt/sbin/xray "$BKPDIR/xray"
		cp -f "$ADBLOCK_HOSTS_FILE" "$BKPDIR/" 2>/dev/null
		cp -f "$ADBLOCK_BLOCK_FILE" "$BKPDIR/" 2>/dev/null
		cp -f "$ADBLOCK_LIST_EXCEPTION" "$BKPDIR/" 2>/dev/null
		cp -f "$ADBLOCK_SOURCES_LIST" "$BKPDIR/" 2>/dev/null
		[ -f /opt/etc/awg/awg.conf ] && cp -f /opt/etc/awg/awg.conf "$BKPDIR/" 2>/dev/null
		[ -f /opt/apps/kvas/awg/bin/wireproxy ] && cp -f /opt/apps/kvas/awg/bin/wireproxy "$BKPDIR/" 2>/dev/null
		[ -f /opt/etc/kvas.failover.conf ] && cp -f /opt/etc/kvas.failover.conf "$BKPDIR/" 2>/dev/null
		[ -f /opt/etc/inface_equals ] && cp -f /opt/etc/inface_equals "$BKPDIR/" 2>/dev/null
		# --- полный охват: AdGuard service + data, feature flags, parental, hosts, awg env ---
		[ -f /opt/etc/init.d/S99adguardhome ] && cp -f /opt/etc/init.d/S99adguardhome "$BKPDIR/" 2>/dev/null
		[ -f /opt/bin/AdGuardHome ] && cp -f /opt/bin/AdGuardHome "$BKPDIR/" 2>/dev/null
		[ -f /opt/etc/hosts ] && cp -f /opt/etc/hosts "$BKPDIR/" 2>/dev/null
		[ -f /opt/etc/kvas-failover-enabled ] && cp -f /opt/etc/kvas-failover-enabled "$BKPDIR/" 2>/dev/null
		[ -f /opt/etc/kvas-monitor-web-enabled ] && cp -f /opt/etc/kvas-monitor-web-enabled "$BKPDIR/" 2>/dev/null
		[ -f /opt/apps/kvas/awg/etc/conf/env.sh ] && cp -f /opt/apps/kvas/awg/etc/conf/env.sh "$BKPDIR/awg.env.sh" 2>/dev/null
		[ -f /opt/etc/adblock/temporary.list ] && cp -f /opt/etc/adblock/temporary.list "$BKPDIR/" 2>/dev/null
		[ -d /opt/etc/adblock/parental.d ] && cp -a /opt/etc/adblock/parental.d "$BKPDIR/parental.d" 2>/dev/null
		[ -f /opt/etc/dnsmasq.d/kvas-parental.dnsmasq ] && cp -f /opt/etc/dnsmasq.d/kvas-parental.dnsmasq "$BKPDIR/" 2>/dev/null
		# AdGuardHome data (querylog/filters) — tar, чтобы не плодить файлы
		if [ -d /opt/etc/AdGuardHome/data ]; then
			tar -czf "$BKPDIR/AdGuardHome.data.tgz" -C /opt/etc/AdGuardHome data 2>/dev/null
		fi
		# magic ELF check для бинарников
		for _bn in hysteria xray wireproxy AdGuardHome; do
			[ -f "$BKPDIR/$_bn" ] || continue
			_hdr=$(head -c 4 "$BKPDIR/$_bn" 2>/dev/null | od -An -tx1 | tr -d ' \n')
			if [ "$_hdr" != "7f454c46" ]; then
				echo "ВНИМАНИЕ: $_bn в бэкапе не ELF — пропущен"
				rm -f "$BKPDIR/$_bn"
			fi
		done
		_n=$(ls -A "$BKPDIR" 2>/dev/null | wc -l)
		if [ "${_n:-0}" -eq 0 ]; then
			echo "ОШИБКА: нечего сохранять"
			rmdir "$BKPDIR" 2>/dev/null
			exit 1
		fi
		echo "Резервная копия сохранена: $BKPDIR"
		;;
	restore)
		if [ -n "$2" ]; then
			BKP="$2"
		else
			BKP=$(ls -dt /opt/kvas_backup_* 2>/dev/null | head -1)
			[ -z "$BKP" ] && echo "Нет резервных копий" && exit 1
		fi
		if [ ! -d "$BKP" ]; then
			echo "ОШИБКА: каталог бэкапа не найден: $BKP"
			exit 1
		fi
		# нормализуем: если внутри архива лежит kvas_backup_*, берём его
		if [ ! -f "$BKP/kvas.conf" ] && [ ! -f "$BKP/kvas.list" ]; then
			_inner=$(find "$BKP" -maxdepth 3 -name 'kvas.conf' -o -name 'kvas.list' 2>/dev/null | head -1)
			if [ -n "$_inner" ]; then
				BKP=$(dirname "$_inner")
			fi
		fi
		_restored=0
		for _f in "$KVAS_LIST_FILE" "$TAGS_LIST_FILE" "$KVAS_CONF_FILE" "$HYSTERIA_CONFIG" "$HYSTERIA_ENV_FILE" "$SHADOWSOCKS_CONF" "$DNSMASQ_CONFIG" "$DNSMASQ_IPSET_HOSTS" "$DNSCRYPT_CONFIG" "$ADGUARDHOME_CONFIG" "$ADGUARD_IPSET_FILE" "$VLESS_CONFIG_FILE" "$ADBLOCK_HOSTS_FILE" "$ADBLOCK_BLOCK_FILE" "$ADBLOCK_LIST_EXCEPTION" "$ADBLOCK_SOURCES_LIST"; do
			[ -z "$_f" ] && continue
			_bn=$(basename "$_f" 2>/dev/null)
			[ -z "$_bn" ] && continue
			_b="${BKP}/${_bn}"
			if [ -f "$_b" ]; then
				mkdir -p "$(dirname "$_f")" 2>/dev/null
				if cp -f "$_b" "$_f" 2>/dev/null; then
					echo "Восстановлен: ${_bn}"
					_restored=$((_restored + 1))
				else
					echo "ОШИБКА: не скопирован ${_bn}"
				fi
			fi
		done
		_f="$KVAS_WEB_PASS"; [ -n "$_f" ] && {
			_bn=$(basename "$_f" 2>/dev/null)
			[ -n "$_bn" ] && {
				_b="${BKP}/${_bn}"
				if [ -f "$_b" ]; then
					mkdir -p "$(dirname "$_f")" 2>/dev/null
					cp -f "$_b" "$_f" 2>/dev/null && echo "Восстановлен: ${_bn}" && _restored=$((_restored + 1))
				fi
			}
		}
		# hysteria: только ELF, с mkdir
		if [ -f "${BKP}/hysteria" ]; then
			_hdr=$(head -c 4 "${BKP}/hysteria" 2>/dev/null | od -An -tx1 | tr -d ' \n')
			if [ "$_hdr" = "7f454c46" ]; then
				mkdir -p /opt/apps/kvas/hysteria/bin
				if cp -f "${BKP}/hysteria" /opt/apps/kvas/hysteria/bin/hysteria 2>/dev/null; then
					chmod 755 /opt/apps/kvas/hysteria/bin/hysteria
					echo "Восстановлен бинарник hysteria (ELF OK)"
					_restored=$((_restored + 1))
				else
					echo "ОШИБКА: hysteria не скопирован"
				fi
			else
				echo "ОШИБКА: hysteria в бэкапе не ELF — пропущен"
			fi
		fi
		# xray binary
		if [ -f "${BKP}/xray" ]; then
			_hdr=$(head -c 4 "${BKP}/xray" 2>/dev/null | od -An -tx1 | tr -d ' \n')
			if [ "$_hdr" = "7f454c46" ]; then
				mkdir -p /opt/sbin
				if cp -f "${BKP}/xray" /opt/sbin/xray 2>/dev/null; then
					chmod 755 /opt/sbin/xray
					echo "Восстановлен бинарник xray (ELF OK)"
					_restored=$((_restored + 1))
				fi
			else
				echo "ОШИБКА: xray в бэкапе не ELF — пропущен"
			fi
		fi
		[ -f "${BKP}/awg.conf" ] && { mkdir -p /opt/etc/awg; cp -f "${BKP}/awg.conf" /opt/etc/awg/awg.conf 2>/dev/null && echo "Восстановлен: awg.conf" && _restored=$((_restored + 1)); }
		[ -f "${BKP}/wireproxy" ] && {
			_hdr=$(head -c 4 "${BKP}/wireproxy" 2>/dev/null | od -An -tx1 | tr -d ' \n')
			if [ "$_hdr" = "7f454c46" ]; then
				mkdir -p /opt/apps/kvas/awg/bin
				cp -f "${BKP}/wireproxy" /opt/apps/kvas/awg/bin/wireproxy 2>/dev/null && chmod 755 /opt/apps/kvas/awg/bin/wireproxy && echo "Восстановлен бинарник wireproxy" && _restored=$((_restored + 1))
			fi
		}
		[ -f "${BKP}/kvas.failover.conf" ] && cp -f "${BKP}/kvas.failover.conf" /opt/etc/kvas.failover.conf 2>/dev/null && echo "Восстановлен: kvas.failover.conf" && _restored=$((_restored + 1))
		[ -f "${BKP}/inface_equals" ] && cp -f "${BKP}/inface_equals" /opt/etc/inface_equals 2>/dev/null && echo "Восстановлен: inface_equals" && _restored=$((_restored + 1))
		# --- полный охват: AdGuard service + data, feature flags, parental, hosts, awg env ---
		if [ -f "${BKP}/S99adguardhome" ]; then
			cp -f "${BKP}/S99adguardhome" /opt/etc/init.d/S99adguardhome 2>/dev/null && chmod 755 /opt/etc/init.d/S99adguardhome && echo "Восстановлен: S99adguardhome" && _restored=$((_restored + 1))
		elif [ -f /opt/apps/kvas/etc/init.d/S99adguard ]; then
			# init отсутствует в старом бэкапе — разворачиваем из пакета, чтобы has_adguard_enable не падал
			cp -f /opt/apps/kvas/etc/init.d/S99adguard /opt/etc/init.d/S99adguardhome 2>/dev/null && chmod 755 /opt/etc/init.d/S99adguardhome && echo "Восстановлен: S99adguardhome (из пакета)" && _restored=$((_restored + 1))
		fi
		if [ -f "${BKP}/AdGuardHome" ]; then
			_hdr=$(head -c 4 "${BKP}/AdGuardHome" 2>/dev/null | od -An -tx1 | tr -d ' \n')
			[ "$_hdr" = "7f454c46" ] && cp -f "${BKP}/AdGuardHome" /opt/bin/AdGuardHome 2>/dev/null && chmod 755 /opt/bin/AdGuardHome && echo "Восстановлен: AdGuardHome binary" && _restored=$((_restored + 1))
		fi
		[ -f "${BKP}/hosts" ] && cp -f "${BKP}/hosts" /opt/etc/hosts 2>/dev/null && echo "Восстановлен: hosts" && _restored=$((_restored + 1))
		[ -f "${BKP}/kvas-failover-enabled" ] && cp -f "${BKP}/kvas-failover-enabled" /opt/etc/kvas-failover-enabled 2>/dev/null && echo "Восстановлен: kvas-failover-enabled" && _restored=$((_restored + 1))
		[ -f "${BKP}/kvas-monitor-web-enabled" ] && cp -f "${BKP}/kvas-monitor-web-enabled" /opt/etc/kvas-monitor-web-enabled 2>/dev/null && echo "Восстановлен: kvas-monitor-web-enabled" && _restored=$((_restored + 1))
		[ -f "${BKP}/awg.env.sh" ] && mkdir -p /opt/apps/kvas/awg/etc/conf && cp -f "${BKP}/awg.env.sh" /opt/apps/kvas/awg/etc/conf/env.sh 2>/dev/null && echo "Восстановлен: awg env.sh" && _restored=$((_restored + 1))
		[ -f "${BKP}/temporary.list" ] && mkdir -p /opt/etc/adblock && cp -f "${BKP}/temporary.list" /opt/etc/adblock/temporary.list 2>/dev/null && echo "Восстановлен: temporary.list" && _restored=$((_restored + 1))
		[ -d "${BKP}/parental.d" ] && mkdir -p /opt/etc/adblock/parental.d && cp -a "${BKP}/parental.d/." /opt/etc/adblock/parental.d/ 2>/dev/null && echo "Восстановлен: parental.d" && _restored=$((_restored + 1))
		[ -f "${BKP}/kvas-parental.dnsmasq" ] && mkdir -p /opt/etc/dnsmasq.d && cp -f "${BKP}/kvas-parental.dnsmasq" /opt/etc/dnsmasq.d/kvas-parental.dnsmasq 2>/dev/null && echo "Восстановлен: kvas-parental.dnsmasq" && _restored=$((_restored + 1))
		if [ -f "${BKP}/AdGuardHome.data.tgz" ]; then
			mkdir -p /opt/etc/AdGuardHome 2>/dev/null
			tar -xzf "${BKP}/AdGuardHome.data.tgz" -C /opt/etc/AdGuardHome 2>/dev/null && echo "Восстановлен: AdGuardHome data" && _restored=$((_restored + 1))
		fi
		if [ "${_restored}" -eq 0 ]; then
			echo "ОШИБКА: в $BKP не найдено файлов для восстановления"
			exit 1
		fi
		echo "Восстановлено файлов: ${_restored}"
		# Файлы на месте — пересоздаём NDM-хуки и поднимаем службы
		home_dir=/opt/apps/kvas
		hook_dir=$(get_hook_dir)
		mkdir -p "/opt/etc/ndm/${hook_dir}" /opt/etc/ndm/iflayerchanged.d /opt/etc/ndm/ifcreated.d /opt/etc/ndm/ifdestroyed.d /opt/etc/ndm/netfilter.d
		ln -sf "${home_dir}/etc/ndm/${hook_dir}/100-kvas-vpn" "/opt/etc/ndm/${hook_dir}/100-kvas-vpn"
		ln -sf "${home_dir}/etc/ndm/iflayerchanged.d/kvas-ips-reset" "/opt/etc/ndm/iflayerchanged.d/kvas-ips-reset"
		ln -sf "${home_dir}/etc/ndm/ifcreated.d/kvas-iface-add" "/opt/etc/ndm/ifcreated.d/kvas-iface-add"
		ln -sf "${home_dir}/etc/ndm/ifdestroyed.d/kvas-iface-del" "/opt/etc/ndm/ifdestroyed.d/kvas-iface-del"
		ln -sf "${home_dir}/etc/ndm/netfilter.d/100-vpn-mark" "/opt/etc/ndm/netfilter.d/100-vpn-mark"
		echo "Хуки NDM пересозданы"
		cmd_kvas_init "no_reset"
		# явно поднимаем AdGuard, если он был включён (has_adguard_enable требует init-файл)
		if grep -q '^ADGUARD_ENABLE=true' /opt/etc/kvas.conf 2>/dev/null && [ -f /opt/etc/init.d/S99adguardhome ]; then
			/opt/etc/init.d/S99adguardhome status 2>/dev/null | grep -qi alive || {
				/opt/etc/init.d/S99adguardhome start >/dev/null 2>&1
				echo "AdGuardHome запущен после восстановления"
			}
		fi
		echo "Сервисы перезапущены"
		;;

	tags)
		case "${2}" in
			list) 			cmd_show_tags_domain_list "${3}" ;;
			add)			cmd_add_domain_to_tag_list "${3}" "${4}" ;;
			del)			cmd_del_domain_from_tag_list "${3}" "${4}" ;;
			update)			cmd_update_tags_domain_list "${3}";;
			create)			shift 2; cmd_create_tag_section "$@" ;;
			add-protect)	cmd_add_tag_section_to_protect_list_noninteractive "${3}" ;;
			del-protect)	cmd_del_tag_section_from_protect_list_noninteractive "${3}" ;;
			edit)			cmd_edit_tag_section "${3}" ;;
			edit-save)		shift 2; _es_section="$1"; shift; cmd_edit_tag_section_noninteractive "$_es_section" "$*" ;;
			delete)		cmd_del_tag_section_from_protect_list_noninteractive "${3}"
					cmd_del_tag_section_noninteractive "${3}" ;;
			*) 				cmd_show_tags_domain_list "${2}" ;;
		esac
		;;
	add_tags)
		tag="$2"
		if [ -z "$tag" ]; then
			add_tag_section_to_protect_list
		else
			cmd_add_tag_section_to_protect_list_noninteractive "$tag"
		fi
		;;
	del_tags)
		tag="$2"
		if [ -z "$tag" ]; then
			del_tag_section_to_protect_list
		else
			cmd_del_tag_section_from_protect_list_noninteractive "$tag"
		fi
		;;

	# Расширенные настройки

	# Тоннели

	vless)
		case "${2}" in
			new) 	rm -f "${VLESS_CONFIG_FILE}" 
					start_vless "$(cat ${INFACE_NAMES_FILE} | grep vless | cut -d'|' -f2)"
					cmd_kvas_init "no" >/dev/null 2>&1
				;;
			*) 		cmd_install_proxy_package 
				;;
		esac	
			;;

	hysteria)
		case "${2}" in
			install)	cmd_hysteria_install ;;
			uninstall)	cmd_hysteria_uninstall ;;
			new)		cmd_hysteria_new ;;
			test)		cmd_hysteria_test; _h_rc=$?; [ "${_h_rc}" -ne 0 ] 2>/dev/null && tg_notify test_err "hysteria test: код ${_h_rc}" ;;
			start)		cmd_hysteria_start ;;
			stop)		cmd_hysteria_stop ;;
			restart)	cmd_hysteria_restart ;;
			status | *)	cmd_hysteria_status ;;
 		esac
 		;;

	awg)
		case "${2}" in
			new)		cmd_awg_new "${3}" ;;
			install)	cmd_awg_install ;;
			uninstall)	cmd_awg_uninstall ;;
			test)		cmd_awg_test; _a_rc=$?; [ "${_a_rc}" -ne 0 ] 2>/dev/null && tg_notify test_err "awg test: код ${_a_rc}" ;;
			start)		cmd_awg_start ;;
			stop)		cmd_awg_stop ;;
			restart)	cmd_awg_restart ;;
			status | *)	cmd_awg_status ;;
		esac
		;;

	xray)
		case "${2}" in
			core)		cmd_xray_core "${3}" ;;
			status|*)	cmd_xray_status ;;
		esac
		;;

	failover)
		cmd_failover "${2}" "${3}" "${4}"
		;;

	ssr)
		case "${2}" in
			new)			cmd_shadowsocks_read_new_data ;;
			port) 			cmd_shadowsocks_local_port_change "${3}" ;;
			reset) 			cmd_shadowsocks_iptable_reset && all_services_restart;;
			status | *) 	cmd_vpn_status ;;
		esac
		;;

	vpn)
		case "${2}" in
			set)
				case "${3}" in
					vless|hysteria)
						LOG="/tmp/kvas-vpn-set.log"
						: > "$LOG"
						
						_ts() { date '+%H:%M:%S'; }
						_sec() { date +%s; }
						
						_t=$(_ts); echo "[KVAS_SET] $_t === Начало переключения на ${3} ===" >&2; echo "[KVAS_SET] $_t === Начало переключения на ${3} ===" >> "$LOG"
						
						proto="${3}"
						iface_ent=""
						iface_cli=""
						
						_t=$(_ts); echo "[KVAS_SET] $_t Инициализация: proto=$proto" >&2; echo "[KVAS_SET] $_t Инициализация: proto=$proto" >> "$LOG"
						
						if [ "$proto" = "vless" ]; then
							_t=$(_ts); echo "[KVAS_SET] $_t Определение iface для vless" >&2; echo "[KVAS_SET] $_t Определение iface для vless" >> "$LOG"
							iface_cli="${PROXY_VLESS_NAME:-Proxy21}"
							_t=$(_ts); echo "[KVAS_SET] $_t PROXY_VLESS_NAME=[${PROXY_VLESS_NAME}]" >&2; echo "[KVAS_SET] $_t PROXY_VLESS_NAME=[${PROXY_VLESS_NAME}]" >> "$LOG"
							iface_ent=$(grep "^${iface_cli}|" "${INFACE_NAMES_FILE}" 2>/dev/null | cut -d'|' -f2)
							_t=$(_ts); echo "[KVAS_SET] $_t grep из INFACE_NAMES_FILE: iface_ent=[$iface_ent]" >&2; echo "[KVAS_SET] $_t grep из INFACE_NAMES_FILE: iface_ent=[$iface_ent]" >> "$LOG"
							[ -z "$iface_ent" ] && iface_ent="$iface_cli" && _t=$(_ts); echo "[KVAS_SET] $_t iface_ent пуст, использую iface_cli=$iface_cli" >&2; echo "[KVAS_SET] $_t iface_ent пуст, использую iface_cli=$iface_cli" >> "$LOG"
						else
							_t=$(_ts); echo "[KVAS_SET] $_t Определение iface для hysteria" >&2; echo "[KVAS_SET] $_t Определение iface для hysteria" >> "$LOG"
							iface_cli="Proxy41"
							iface_ent=$(grep "^${iface_cli}|" "${INFACE_NAMES_FILE}" 2>/dev/null | cut -d'|' -f2)
							_t=$(_ts); echo "[KVAS_SET] $_t grep из INFACE_NAMES_FILE: iface_ent=[$iface_ent]" >&2; echo "[KVAS_SET] $_t grep из INFACE_NAMES_FILE: iface_ent=[$iface_ent]" >> "$LOG"
							[ -z "$iface_ent" ] && iface_ent="$iface_cli" && _t=$(_ts); echo "[KVAS_SET] $_t iface_ent пуст, использую iface_cli=$iface_cli" >&2; echo "[KVAS_SET] $_t iface_ent пуст, использую iface_cli=$iface_cli" >> "$LOG"
						fi
						
						_t=$(_ts); echo "[KVAS_SET] $_t INFACE_NAMES_FILE=${INFACE_NAMES_FILE}" >&2; echo "[KVAS_SET] $_t INFACE_NAMES_FILE=${INFACE_NAMES_FILE}" >> "$LOG"
						_t=$(_ts); echo "[KVAS_SET] $_t iface_ent=[${iface_ent}] iface_cli=[${iface_cli}]" >&2; echo "[KVAS_SET] $_t iface_ent=[${iface_ent}] iface_cli=[${iface_cli}]" >> "$LOG"
						if [ -f "${INFACE_NAMES_FILE}" ]; then
							while IFS= read -r line; do _t=$(_ts); echo "[KVAS_SET] $_t   $line" >&2; echo "[KVAS_SET] $_t   $line" >> "$LOG"; done < "${INFACE_NAMES_FILE}"
						else
							_t=$(_ts); echo "[KVAS_SET] $_t ФАЙЛ НЕ СУЩЕСТВУЕТ!" >&2; echo "[KVAS_SET] $_t ФАЙЛ НЕ СУЩЕСТВУЕТ!" >> "$LOG"
							ls -la /opt/etc/ 2>&1 | while IFS= read -r line; do _t=$(_ts); echo "[KVAS_SET] $_t   $line" >&2; echo "[KVAS_SET] $_t   $line" >> "$LOG"; done
						fi
						
						_s=$(_sec); _t=$(_ts); echo "[KVAS_SET] $_t >>> stop_failover_daemon" >&2; echo "[KVAS_SET] $_t >>> stop_failover_daemon" >> "$LOG"
						stop_failover_daemon > /dev/null 2>&1
						_d=$(( $(_sec) - _s )); _t=$(_ts); echo "[KVAS_SET] $_t <<< stop_failover_daemon (${_d}s)" >&2; echo "[KVAS_SET] $_t <<< stop_failover_daemon (${_d}s)" >> "$LOG"
						
						is_install_stage=no
						_t=$(_ts); echo "[KVAS_SET] $_t is_install_stage=no" >&2; echo "[KVAS_SET] $_t is_install_stage=no" >> "$LOG"
						
						# Не даём switch_vpn_on остановить xray (нужен для failover)
						_XRAY_INIT_SAVE="$XRAY_INIT"
						XRAY_INIT="/bin/true"
						_t=$(_ts); echo "[KVAS_SET] $_t XRAY_INIT=/bin/true (предотвращаем остановку xray)" >&2; echo "[KVAS_SET] $_t XRAY_INIT=/bin/true (предотвращаем остановку xray)" >> "$LOG"
						
						_s=$(_sec); _t=$(_ts); echo "[KVAS_SET] $_t >>> switch_vpn_on(ent=${iface_ent}, cli=${iface_cli})" >&2; echo "[KVAS_SET] $_t >>> switch_vpn_on(ent=${iface_ent}, cli=${iface_cli})" >> "$LOG"
						switch_vpn_on "${iface_ent}" "${iface_cli}"
						_d=$(( $(_sec) - _s )); _t=$(_ts); echo "[KVAS_SET] $_t <<< switch_vpn_on (${_d}s)" >&2; echo "[KVAS_SET] $_t <<< switch_vpn_on (${_d}s)" >> "$LOG"
						
						XRAY_INIT="$_XRAY_INIT_SAVE"
						_t=$(_ts); echo "[KVAS_SET] $_t XRAY_INIT восстановлен" >&2; echo "[KVAS_SET] $_t XRAY_INIT восстановлен" >> "$LOG"
						
						# Убеждаемся что xray запущен (для failover check_vless)
						_s=$(_sec); _t=$(_ts); echo "[KVAS_SET] $_t >>> service_action S97xray start" >&2; echo "[KVAS_SET] $_t >>> service_action S97xray start" >> "$LOG"
						service_action S97xray start > /dev/null 2>&1
						_d=$(( $(_sec) - _s )); _t=$(_ts); echo "[KVAS_SET] $_t <<< service_action S97xray start (${_d}s)" >&2; echo "[KVAS_SET] $_t <<< service_action S97xray start (${_d}s)" >> "$LOG"
						sleep 1
						
						if [ "$proto" = "hysteria" ]; then
							_s=$(_sec); _t=$(_ts); echo "[KVAS_SET] $_t >>> service_action S99hysteria start" >&2; echo "[KVAS_SET] $_t >>> service_action S99hysteria start" >> "$LOG"
							service_action S99hysteria start > /dev/null 2>&1
							_d=$(( $(_sec) - _s )); _t=$(_ts); echo "[KVAS_SET] $_t <<< service_action S99hysteria start (${_d}s)" >&2; echo "[KVAS_SET] $_t <<< service_action S99hysteria start (${_d}s)" >> "$LOG"
						fi
						
						_s=$(_sec); _t=$(_ts); echo "[KVAS_SET] $_t >>> load_failover_conf + save" >&2; echo "[KVAS_SET] $_t >>> load_failover_conf + save" >> "$LOG"
						load_failover_conf
						PRIMARY="$proto"
						save_failover_conf
						_d=$(( $(_sec) - _s )); _t=$(_ts); echo "[KVAS_SET] $_t <<< PRIMARY обновлён на $proto (${_d}s)" >&2; echo "[KVAS_SET] $_t <<< PRIMARY обновлён на $proto (${_d}s)" >> "$LOG"
						
						_s=$(_sec); _t=$(_ts); echo "[KVAS_SET] $_t >>> update_iptables" >&2; echo "[KVAS_SET] $_t >>> update_iptables" >> "$LOG"
						update_iptables
						_d=$(( $(_sec) - _s )); _t=$(_ts); echo "[KVAS_SET] $_t <<< update_iptables (${_d}s)" >&2; echo "[KVAS_SET] $_t <<< update_iptables (${_d}s)" >> "$LOG"
						
						_s=$(_sec); _t=$(_ts); echo "[KVAS_SET] $_t >>> start_failover_daemon" >&2; echo "[KVAS_SET] $_t >>> start_failover_daemon" >> "$LOG"
						start_failover_daemon > /dev/null 2>&1 &
						echo $! > /var/run/kvas-failover.pid
						_d=$(( $(_sec) - _s )); _t=$(_ts); echo "[KVAS_SET] $_t <<< failover daemon запущен PID $! (${_d}s)" >&2; echo "[KVAS_SET] $_t <<< failover daemon запущен PID $! (${_d}s)" >> "$LOG"
						
						_t=$(_ts); echo "[KVAS_SET] $_t === Переключение на $proto завершено ===" >&2; echo "[KVAS_SET] $_t === Переключение на $proto завершено ===" >> "$LOG"
						;;
					*)
						if [ -n "${3}" ]; then
						_found_ent=''; _found_cli=''
						while IFS='|' read -r _fc _fe _fd _fr; do
							# Убираем кавычки из описания
							_fd_clean=$(echo "${_fd}" | sed 's/^"//; s/"$//')
							# Ищем по cli, entware или описанию
							if [ "${_fe}" = "${3}" ] || [ "${_fc}" = "${3}" ] || [ "${_fd_clean}" = "${3}" ]; then
								_found_ent="${_fe}"; _found_cli="${_fc}"; break
							fi
						done < "${INFACE_NAMES_FILE}" 2>/dev/null
						if [ -n "${_found_ent}" ]; then
							is_install_stage=no
							switch_vpn_on "${_found_ent}" "${_found_cli}"
							update_iptables
							all_services_restart
							# Если failover включён — обновляем PRIMARY = выбранный вручную канал
							# Используем тот же формат что get_active_iface (vless/hysteria/описание)
							if [ -f /opt/etc/kvas-failover-enabled ]; then
								case "${_found_cli}" in
									*Proxy21*) _new_primary="vless" ;;
									*Proxy41*) _new_primary="hysteria" ;;
									*)
										_new_primary=$(grep "|${_found_ent}|" /opt/etc/inface_equals 2>/dev/null | head -1 | cut -d'|' -f3 | sed 's/^"//; s/"$//')
										[ -n "$_new_primary" ] || _new_primary="${3}"
										;;
								esac
								/opt/bin/kvas failover set primary "$_new_primary" >/dev/null 2>&1
							fi
						else
							error "Интерфейс '${3}' не найден. Используйте 'kvas vpn set' для интерактивного выбора."
							exit 1
						fi
					else
						cmd_interface_change no && update_iptables && all_services_restart
					fi ;;
				esac
				;;
			gateway) 		cmd_manual_gateway_set "${3}" ;;
			reset) 			update_iptables && all_services_restart ;;
			net | guest)
				case "${3}" in
					add ) 			cmd_bridge_vpn_access_add && cmd_vpn_iptable_reset &> /dev/null;;
					del ) 			cmd_bridge_vpn_access_del && cmd_vpn_iptable_reset &> /dev/null;;
					*) 				cmd_bridge_vpn_access_list ;;
				esac
				;;

			rescan | scan)	cmd_scan_interface_list ;;
			status | *) 	cmd_vpn_status ;;
		esac
		;;

	# DNS

	dns)
		case "${2}" in
			server) 		dns_server_install_remotely "${3}" ;;
			test) 			cmd_dns_test "${3}";;
			*) 				cmd_dnsmasq_dns_change "${2}" ;;
		esac
		;;

	dnsmasq)
		case "${2}" in
			port) 			cmd_dnsmasq_port_change "${3}" ;;
			ip) 			cmd_dnsmasq_dns_change "${3}";;
			on)				cmd_adguardhome_off ;;
			status | *) 	exit_when_adguard_on status;
							[ "${status}" = 0 ] && {
								cmd_dnsmasq_listen_show;
							} ;;
		esac
		;;

	crypt | dnscrypt)
		case "${2}" in
			on) 			cmd_dns_crypt_on ;;
			off) 			cmd_dns_crypt_off ;;
			status | *) 	cmd_dns_crypt_status_show ;;
		esac
		;;

	adblock | ads)
		case "${2}" in
			on) 			cmd_ads_protect_on ask;;
			off) 			cmd_ads_protect_off ;;
			edit) 			cmd_ads_edit ;;
			add)			cmd_ads_add_host "${3}" ;;
			del)			cmd_ads_del_from_skip_list "${3}" ;;
			status | *) 	cmd_ads_status ;;
		esac
		;;

	adguard)
		case "${2}" in
			on) 			cmd_adguardhome_on ;;
			off) 			cmd_adguardhome_off ;;
			uninstall)		cmd_adguardhome_uninstall ;;
			test)			cmd_adguard_check ;;
			update)			cmd_adguard_update ;;
			restart)		/opt/etc/init.d/S99adguardhome restart
				exit 0
				;;
			*) 				cmd_adguardhome_status ;;
		esac
		;;

	hosts)
		case "${2}" in
			add ) 			cmd_hosts_one_add "${3}" "${4}" ;;
			del ) 			cmd_hosts_one_del "${3}";;
			prune ) 		cmd_hosts_prune ;;
			edit ) 			cmd_hosts_edit ;;
			*) 				cmd_hosts_list ;;
		esac
		;;

	# Маршрутизация

	tunnel)
		cmd_tunnel
	;;
	route)
		case "${2}" in
			refresh | recreate) cmd_route_refresh ;;
			add)                cmd_route_add "${3}" "${4}" ;;
			del)                cmd_route_del "${3}" "${4}" ;;
			list)               cmd_route_list ;;
			*)                  cmd_route         ;;
		esac
		;;

	# Поиск и устранение неисправностей

	log)
		case "${2}" in
			error | err)
				if [ "${3}" = "detail" ] || [ "${3}" = "full" ]; then
					# Показываем ВСЕ ошибки из лог-файла (фильтр [E])
					print_line
					echo "Полные ошибки КВАС:"
					print_line
					if [ -f /opt/tmp/kvas_errors.log ] && [ -s /opt/tmp/kvas_errors.log ]; then
						grep "\[E\]" /opt/tmp/kvas_errors.log | tail -n "${4:-50}"
					else
						echo "Лог-файл пуст."
					fi
				else
					# Показываем ошибки из лог-файла (фильтр [E])
					if [ -f /opt/tmp/kvas_errors.log ] && [ -s /opt/tmp/kvas_errors.log ]; then
						print_line
						echo "Ошибки КВАС:"
						print_line
						grep "\[E\]" /opt/tmp/kvas_errors.log | tail -n "${3:-20}"
					else
						syslog__show "${2}" 'КВАС' 'Ошибки Кваса:' "${3}"
					fi
				fi
			;;
			info)        syslog__show "${2}" 'КВАС' 'Информационные сообщения Кваса:' "${3}" ;;
			clear)       > /opt/tmp/kvas_errors.log 2>/dev/null; echo "Лог очищен." ;;
			*)           syslog__show ''     'КВАС' 'События Кваса:'                  "${2}" ;;
		esac
	;;
	syslog)
		case "${2}" in
			error | err) syslog__show "${2}" '!КВАС' 'Ошибки системы:'                   "${3}" ;;
			info)        syslog__show "${2}" '!КВАС' 'Информационные сообщения системы:' "${3}" ;;
			*)           syslog__show ''     '!КВАС' 'События системы:'                  "${2}" ;;
		esac
	;;

	ipset)
		case "${2}" in
			add)           cmd_ipset_add "${3}" ;;
			clear | flush) cmd_ipset_flush      ;;
			refill)        cmd_ipset_refill     ;;
			*)             cmd_ipset "${2}"     ;;
		esac
		;;

	debug)
		case "${2}" in
			dns)      cmd_debug_dns          ;;
			iptables) cmd_debug_iptables     ;;
			*)        cmd_print_debug "${2}" ;;
		esac
		;;

	test | check) cmd_test_warning "${2}"
	;;
	test_old | check_old) cmd_state_checker "${2}"
	                      [ -n "${2}" ] && exit 0
	;;

	monitor|monitoring)
		case "${2}" in
			web)
				case "${3}" in
					stop|off) cmd_monitor_web_stop ;;
					*)        cmd_monitor_web_start ;;
				esac ;;
			start|on)  cmd_monitor_web_start ;;
			stop|off)  cmd_monitor_web_stop ;;
			*)         cmd_monitor ;;
		esac
		;;

	reset | init)	        cmd_kvas_init "no_reset"
		;;

	# Управление пакетом

	# Обновление

	version | ver)			version
		;;
	upgrade)			sh /opt/apps/kvas/bin/main/upgrade "${2}" "${3}"; exit 0
		;;
	update)				sh /opt/apps/kvas/bin/main/update "${2}"; exit 0
		;;
	rollback)				sh /opt/apps/kvas/bin/main/upgrade rollback "${2}"; exit 0
		;;

	# Отключение и удаление

	pause|freeze)           cmd_pause_kvas ;;
	unpause|unfreeze)       cmd_unpause_kvas ;;

	uninstall ) 			cmd_uninstall  "${2}" "${3}"
		;;

	# Команды

	help|-h|--h ) 			[ -n "${2}" ] && cmd_help | grep "${2}" || cmd_help
		;;
	"")						cmd_help
		;;
	*)						error "Команда '${1}' не известна, список доступных команд:"
							print_line
							cmd_help
		;;
esac

print_line
