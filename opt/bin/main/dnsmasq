#!/bin/sh

#------------------------------------------------------------------------------
#
#	ПАКЕТ КВАС
#
#------------------------------------------------------------------------------
#
#	Данный файл служит для формирования из записей kvas.list
#	специальных записей вида "ipset=/хост/kvas"
# 	для конфигурационного файла dnsmasq типа, которые
# 	записыватся в /opt/etc/dnsmasq.d/kvas.dnsmasq.
#
# -----------------------------------------------------------------------------
#	Разработчик: mail@zeleza.ru
#	Дата создания: 21/05/2022
#	Лицензия: Apache License 2.0
# -----------------------------------------------------------------------------

logger -t 'КВАС' 'Обновление доменной конфигурации DNSMasq'

IPSET_TABLE_NAME=KVAS_LIST
IPSET_TABLE2_NAME=KVAS_LIST2
ipset_file=/opt/etc/dnsmasq.d/kvas.dnsmasq
host_list=/opt/etc/kvas.list

awk 'BEGIN{ipset="'"${IPSET_TABLE_NAME}"'"}
{
    sub(/#.*/,"")
    gsub(/[[:space:]]+/," ")
    sub(/^ /,"")
    sub(/ $/,"")
    if ($0 == "") next
    if ($0 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/) next
    gsub(/\*/,"")
    print "ipset=/" $0 "/" ipset
}' "${host_list}" > "${ipset_file}"

# Список 2 (вторая полоса) — домены из kvas2.list в KVAS_LIST2
host_list2=/opt/etc/kvas2.list
if [ -f "${host_list2}" ]; then
	awk 'BEGIN{ipset="'"${IPSET_TABLE2_NAME}"'"}
	{
	    sub(/#.*/,"")
	    gsub(/[[:space:]]+/," ")
	    sub(/^ /,"")
	    sub(/ $/,"")
	    if ($0 == "") next
	    if ($0 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/) next
	    gsub(/\*/,"")
	    print "ipset=/" $0 "/" ipset
	}' "${host_list2}" >> "${ipset_file}"
fi

# Домены в обход тоннеля (route_excluded_domains) -> ipset исключённых назначений;
# DNAT-цепочка PREROUTING не маркирует трафик к членам KVAS_DESTINATION_EXCLUDED
kvas_conf=/opt/etc/kvas.conf
if [ -f "${kvas_conf}" ]; then
	grep '^route_excluded_domains=' "${kvas_conf}" 2>/dev/null | cut -d= -f2 | tr '+' '\n' | \
		awk 'NF && $0 !~ /^#/ && $0 ~ /\./ {print "ipset=/" $0 "/KVAS_DESTINATION_EXCLUDED"}' >> "${ipset_file}"
fi

exit 0
