# . /opt/apps/kvas/bin/libs/main

# Файл с тегами
TAGS_FILE=/opt/etc/tags.list
KVAS_LIST_FILE=/opt/etc/kvas.list

# ------------------------------------------------------------------------------------------
#
# 	Получаем список тегов и доменов
#
# ------------------------------------------------------------------------------------------
cmd_show_tags_domain_list(){

    section="$1"

    if [ -z "$section" ] ; then
        _list=$(cat < "${TAGS_FILE}")
    else
        grep -q "\[$section\]" "${TAGS_FILE}" || {
            error "Закваска '$section' не обнаружена!"
            return 1
        }
        _list=$(get_tag_domain_list "$section")

    fi


    echo -e "${GREEN}Список доменных имен в заквасках:${NOCL}"
    print_line
    [ -n "$section" ] && echo -e "${GREEN}[$section]${NOCL}"

    IFS=$'\n'
    for line in $_list; do
        if [[ "$line" =~ \[.*?\] ]]; then
            echo -e "  $line"
        else
            echo ''
            echo -e "${GREEN}${line}${NOCL}"

        fi
    done
    unset IFS

}


# ------------------------------------------------------------------------------------------
#
# 	Получаем список тегов
#
# ------------------------------------------------------------------------------------------
get_tags_list(){
    cat < "${TAGS_FILE}" | grep -vE '^#|^$' | grep "\[" | grep "\]" | tr -d ']['
}

# ------------------------------------------------------------------------------------------
#
# 	Получаем список доменных имен по тегу
#
# ------------------------------------------------------------------------------------------
get_tag_domain_list(){
    awk -v section="$1" '/\['"$1"'\]/{flag=1; next} /\[.*\]/{flag=0} flag' "${TAGS_FILE}"
}

# ------------------------------------------------------------------------------------------
#
# 	Получаем первый домен из списка доменных имен по тегу
#
# ------------------------------------------------------------------------------------------
get_first_domain_from_section() {
    get_tag_domain_list "$1" | head -n 1
}

# ------------------------------------------------------------------------------------------
#
#   Функция для проверки наличия секции в файле
#
# ------------------------------------------------------------------------------------------
_check_section() {

    local section="$1"
    if ! grep -q "\[$section\]" "${TAGS_FILE}"; then
        read_ynq "Закваска '$section' не найдена. Добавить?" answer
        if [[ "$answer" =~ [qn] ]] ; then return 1;
        elif [[ "$answer" =~ [y] ]] ; then
            echo -e "\n[$section]" >> "${TAGS_FILE}"
        fi
        print_line

    fi

}

# ------------------------------------------------------------------------------------------
#
#   Функция для получения имени тега по имени домена
#
# ------------------------------------------------------------------------------------------
_get_tagname_by_domain() {
    local domain_name=$1

    # Найти строку с доменом и получить строки до этой строки, затем найти последний тег перед доменом
    sed -n "/^$domain_name$/=" "$TAGS_FILE" | while read -r line_number; do
        sed -n "1,${line_number}p" "$TAGS_FILE" | grep -oP '^\[\K[^\]]+' | tail -1
    done

}
# ------------------------------------------------------------------------------------------
#
#   Функция возврщает список доменных имен, помеченных одним тегом и
#   которых нет в защитном списке
#
# ------------------------------------------------------------------------------------------
_get_same_tag_domains_missing_in_protection_list() {

    local domain="$1"
    local tagname=$(_get_tagname_by_domain "${domain}" | tail -1)
    local _list=""

    get_tag_domain_list "$tagname" | while read -r line; do
        local _host=$(grep "^$line$" "${KVAS_LIST_FILE}")
        if [ -n "$_host" ]; then
            _list="${_list} ${line}"
        fi
    done

    echo "${_list}"
}
# ------------------------------------------------------------------------------------------
#
#   Функция для проверки домена на наличие доменной зоны
#
# ------------------------------------------------------------------------------------------
_check_domain_zone() {
    local domain="$1"

    # Проверка на наличие доменной зоны
    echo "$domain" | grep -qE "\.[a-zA-Z]{2,6}$" || {
        warning "Неверный формат домена."
        warning "Должна быть указана доменная зона (например, .com, .ru, .org)."
        return 1
    }


}

# ------------------------------------------------------------------------------------------
#
#   Функция для добавления домена в секцию
#
# ------------------------------------------------------------------------------------------
cmd_add_domain_to_tag_list() {

    local section="$1"
    local domain="$2"

    _check_domain_zone "${domain}" || return 1
    _check_section "$section" || return 1

    get_tag_domain_list "$section" | grep -q "^$domain$" && {
         warning "Домен '$domain' уже есть в закваске '$section'."
         warning "Пропускаем добавление домена в закваску '$section'..."
        return 1
    }

    ready "Домен '$domain' добавлен в закваску '$section'."
    if sed -i "/\[$section\]/a $domain" "${TAGS_FILE}" ;
    then when_ok "УСПЕШНО"; tg_notify list "Закваска '$section': добавлен $domain";
    else when_bad "ОШИБКА"; fi
}

# -------------------------------------------------------------------------------------------
#
#   Функция для удаления домена из секции
#
# ------------------------------------------------------------------------------------------
cmd_del_domain_from_tag_list() {

    local section="$1"
    local domain="$2"

    if [ -z "${domain}" ] ; then
        read_ynq "Будут удалены все домены с закваской '$section' и само имя закваски.\nВы уверены?" answer
        if [[ "$answer" =~ [qn] ]] ; then return 1; fi
        [ "${answer}" = y ] && {
            cmd_del_tag_section_noninteractive "$section"
            tg_notify list "Закваска '$section': удалена целиком"
        }
        return
    else
        _check_domain_zone "${domain}" || return 1
        grep -q "\[$section\]" "${TAGS_FILE}" || {
            echo "Закваска '$section' не найдена."
            return 1
        }
        if ! grep -q "^$domain$" "${TAGS_FILE}"; then
            echo "Домен '$domain' не обнаружен в закваске '$section'."
            return 1
        fi
        sed -i "/\[$section\]/,/\[.*\]/ { /^$domain$/d }" "${TAGS_FILE}"
        tg_notify list "Закваска '$section': удалён $domain"
    fi
}

cmd_create_tag_section() {
    local section="$1"
    [ -z "$section" ] && { echo "tag name required"; return 1; }
    grep -q "\[$section\]" "${TAGS_FILE}" && { echo "tag '$section' already exists"; return 1; }

    printf '\n[%s]\n' "$section" >> "${TAGS_FILE}"
    shift
    for domain in "$@"; do
        domain=$(echo "$domain" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sed 's~^https\?://~~; s~^www\.~~; s~/\+$~~')
        [ -z "$domain" ] && continue
        echo "$domain" >> "${TAGS_FILE}"
    done
}

cmd_del_tag_section_noninteractive() {
    local section="$1"
    [ -z "$section" ] && return 1
    grep -q "\[$section\]" "${TAGS_FILE}" || return 1
    local tmp_tags=$(mktemp)
    local found=0
    while IFS= read -r line; do
        echo "$line" | grep -q "^\[$section\]$" && { found=1; continue; }
        if [ "$found" -eq 1 ]; then
            echo "$line" | grep -q "^\[" && found=2
        fi
        [ "$found" -ne 1 ] && echo "$line" >> "$tmp_tags"
    done < "${TAGS_FILE}"
    mv -f "$tmp_tags" "${TAGS_FILE}"
}


# --------------------------------------------------------------------------------------------
#
#   Функция для проверки наличия элементов тега в списке kvas
#
# ------------------------------------------------------------------------------------------
has_section_domains_in_list() {
#set -exu
    local section="$1"
    local action="${2}"
    _check_section "$section" || return 1

    local all_present=true
    local none_present=true
    local partial_present=false
    local missing_elements=""

    [ -f "${KVAS_LIST_FILE}" ] || {
        # error "Файл '${KVAS_LIST_FILE}' не найден."
        when_bad "ОШИБКА"
        return 1
    }

    for domain in $(get_tag_domain_list "$section" | sed -e 's/^[[:space:]]*//; s/[[:space:]]*$//' ); do
# echo "$domain"
        if grep -q "^$domain$" "${KVAS_LIST_FILE}" ; then
            none_present=false
            #[ "$action" = "del" ] && none_present=true
        else
            all_present=false
            #[ "$action" = "del" ] && all_present=true
            missing_elements="${missing_elements}$domain "
        fi

    done
#echo "missing_elements=$missing_elements"
    if $all_present; then
        # when_ok "ДОБАВЛЕНА"
        echo 1
    elif $none_present; then
        # when_bad "ОТСУТСТВУЕТ"
        echo 2
    else
        # when_alert "ЧАСТИЧНО"
        echo 3
    fi
# set +exu
}

# --------------------------------------------------------------------------------------------
#
#   Функция для выбора секции из списка
#
# ------------------------------------------------------------------------------------------
tag_select() {

    local tags="$(get_tags_list)"
    local action="$1"

    echo -e "Список заквасок для ${BLUE}${action}${NOCL}:"

    if [ -z "${action}" ] ; then
        error "Не задан режим работы функции tag_select."
        return 1
    fi

    if [ "${action}" = "добавления" ] ; then action="add"; else action="del"; fi


    print_line
    local i=0
    local added_list=""
    local ask_list=""

#set -xeu
    while IFS= read -r tag; do

        local res=$(has_section_domains_in_list "$tag" "$action")

        if [ ${res} -gt 1 ] ; then

            if [ "${action}" = "add" ] ; then
		        i=$((i+1))
                ask_list="${ask_list}$(ready "$i. $tag")"
                [ "${res}" -eq 2 ] && ask_list="${ask_list}$(when_bad "ОТСУТСТВУЕТ")"
                [ "${res}" -eq 3 ] && ask_list="${ask_list}$(when_alert "ЧАСТИЧНО")"
                ask_list="${ask_list}\n"

            else
                if [ "${res}" -eq 2 ]; then
                    # Переводим в список отсутсвующих
                    #res=1
                    added_list="${added_list}$(ready "$tag")"
                    added_list="${added_list}$(when_alert "ОТСУТСТВУЕТ")\n"
                else
                    i=$((i+1))
                    ask_list="${ask_list}$(ready "$i. $tag")"
                    ask_list="${ask_list}$(when_alert "ЧАСТИЧНО")"
                    ask_list="${ask_list}\n"
                fi
            fi

        fi
        if [ ${res} = 1 ]; then
            # если домен уже есть в списке
            if [ "${action}" = "add" ] ; then
                added_list="${added_list}$(ready "$tag" && when_ok "ДОБАВЛЕН")\n"
            else
                i=$((i+1))
                ask_list="${ask_list}$(ready "$i. $tag")"
                if [ "${res}" -eq 1 ]; then
                    ask_list="${ask_list}$(when_bad "В СПИСКЕ")\n"
                fi
            fi
        fi
    done <<EOF
$tags
EOF


#set -xeu
    	[ -n "${added_list}" ] && {
        	echo -e "${added_list}" | sed '/^$/d'
        	[ -n "${ask_list}" ] && print_line
    	}
    	[ -n "${ask_list}" ] && {
            echo -e "${ask_list}" | sed '/^$/d'
        }

#    score=$(echo -e "${ask_list}" | wc -l)

    if [ "$i" -gt 0 ]; then
        print_line
        while true; do
	    local choice
            read -p "Выберите номер закваски из списка [1-$i], A:Все, Q:Выход: " choice

            [[ "${choice}" =~ [qQ] ]] && return 0
            [[ "${choice}" =~ [aA] ]] && break
#set -xeu
           # Проверка на ввод только цифр и в пределах диапазона
            if [[ "${choice}" =~ ^[0-9]+$ ]] && [ ${choice} -ge 1 ] && [ ${choice} -le ${i} ]; then
                break
            else
                error "Неверный ввод. Пожалуйста, введите номер из списка."
            fi

        done
#set -xeu
        if [[ "${choice}" =~ [aA] ]] ; then
            # если выбрано все
            eval "$2=ALL"
        else
	    #local _list=$([ "${action}" = add ] && echo "${ask_list}" || echo "${added_list}")
            chosen_tag=$(echo -e "${ask_list}" | sed -n $choice'p' | sed 's/^[0-9]\{1,3\}. \(.*\) .* .*$/\"\1\"/; /^$/d' | tr -d ' ' )
            eval "$2=$chosen_tag"
        fi

    else
        if [  $(cat < "${TAGS_FILE}" | wc -l) -le 1 ] ; then 
            error "Список заквасок пуст.\nПроверьте наличие заквасок в файле '${TAGS_FILE}'."
        else 
            print_line
            error "Заквасок для удаления не найдено."
        fi
    fi
#set +xeu
}

# --------------------------------------------------------------------------------------------
#
#   Функция для обновления списка заквасок с github
#
# ------------------------------------------------------------------------------------------
cmd_update_tags_domain_list() {

    local _force=${1:-no}
    ready "Обновление списка заквасок с ${BLUE}GitHub${NOCL}  прошло" 

    curl -so /opt/tmp/tags.list https://raw.githubusercontent.com/qzeleza/kvas/refs/heads/main/opt/etc/conf/tags.list && when_ok "УСПЕШНО" || {
        error "Не удалось обновить список заквасок с ${BLUE}GitHub${NOCL}."
        error "Пожалуйста, проверьте интернет соединение."
        return 1
    }
    
    if [ "${_force}" = force ] ; then
        mv -f /opt/tmp/tags.list /opt/etc/tags.list
    else
        local _diff=$(diff /opt/etc/tags.list  /opt/tmp/tags.list  | grep -E '^\+\[' | tr -d +)
        if [ -n "${_diff}" ] ; then
            print_line
            echo -e "В список были добавлены следущие закваски:\n${_diff}"
            print_line
            printf "%s" "${_diff}"
            mv -f /opt/tmp/tags.list /opt/etc/tags.list
        else
            print_line
            echo -e "В удаленном списке на ${BLUE}GitHub${NOCL} новых заквасок ${RED}не обнаружено${NOCL}."
            rm -f /opt/tmp/tags.list
        fi

    fi
}

# --------------------------------------------------------------------------------------------
#
#   Функция для интерактивного редактирования доменов в закваске
#   Если закваска добавлена в тоннель — пересинхронизирует домены
#
# ------------------------------------------------------------------------------------------
cmd_edit_tag_section() {
    local section="$1"
    if [ -z "$section" ]; then
        tag_select "редактирования" section
        [ -z "$section" ] && { error "Закваска не выбрана."; return 1; }
    fi
    _check_section "$section" || return 1

    while :; do
        clear
        print_line
        echo -e "${GREEN}Редактирование закваски: [${section}]${NOCL}"
        print_line
        local domains
        domains=$(get_tag_domain_list "$section")
        if [ -n "$domains" ]; then
            echo "$domains" | nl -w2 -s'. '
        else
            echo -e "${YELLOW}(доменов нет)${NOCL}"
        fi
        print_line
        echo "  a) Добавить домен"
        echo "  r) Удалить домен (по номеру)"
        echo "  d) Готово"
        print_line
        printf "${BLUE}Выберите действие (a/r/d):${NOCL} "
        read -r action
        case "$action" in
            a|A)
                printf "Введите домен: "
                read -r newdom
                [ -z "$newdom" ] && { warning "Домен не введён."; continue; }
                cmd_add_domain_to_tag_list "$section" "$newdom"
                ;;
            r|R)
                printf "Номер домена для удаления: "
                read -r num
                [ -z "$num" ] && { warning "Номер не введён."; continue; }
                local dom_to_del
                dom_to_del=$(echo "$domains" | sed -n "${num}p")
                if [ -z "$dom_to_del" ]; then
                    error "Неверный номер."
                    continue
                fi
                cmd_del_domain_from_tag_list "$section" "$dom_to_del"
                ;;
            d|D)
                break
                ;;
            *)
                warning "Неверный ввод. Используйте a/r/d."
                ;;
        esac
    done

    # Проверяем, есть ли домены этой закваски в списке защиты (тоннеле)
    local in_list
    in_list=$(has_section_domains_in_list "$section")
    if [ "$in_list" -eq 1 ] || [ "$in_list" -eq 3 ]; then
        print_line
        ready "Закваска [${section}] добавлена в тоннель. Обновляем..."
        cmd_del_tag_section_from_protect_list_noninteractive "$section"
        cmd_add_tag_section_to_protect_list_noninteractive "$section"
        print_line
        when_ok "Синхронизация с тоннелем завершена"
    fi
}

# --------------------------------------------------------------------------------------------
#
#   Неинтерактивное редактирование — заменяет все домены в закваске
#   Используется из Web UI
#
# ------------------------------------------------------------------------------------------
cmd_edit_tag_section_noninteractive() {
    local section="$1"
    local new_domains="$2"
    _check_section "$section" || return 1

    local was_in_tunnel=false
    local in_list
    in_list=$(has_section_domains_in_list "$section")
    [ "$in_list" -eq 1 ] || [ "$in_list" -eq 3 ] && was_in_tunnel=true

    if $was_in_tunnel; then
        cmd_del_tag_section_from_protect_list_noninteractive "$section"
    fi

    cmd_del_tag_section_noninteractive "$section"

    # shellcheck disable=SC2086
    cmd_create_tag_section "$section" $new_domains

    if $was_in_tunnel; then
        cmd_add_tag_section_to_protect_list_noninteractive "$section"
    fi
}