#!/bin/sh
# ------------------------------------------------------------------------------------------
#
# 	ПРОЕКТ КВАС
#
# 	Модуль автопереключения между VPN каналами
# 	Поддержка: vless, hysteria, OpenConnect, WireGuard, AWG, и др.
# ------------------------------------------------------------------------------------------
FAILOVER_FLAG=/opt/etc/kvas-failover-enabled
. /opt/apps/kvas/bin/libs/main
. /opt/apps/kvas/bin/libs/vpn
. /opt/apps/kvas/bin/libs/awg 2>/dev/null

FAILOVER_CONF="/opt/etc/kvas.failover.conf"
FAILOVER_LOG="/opt/var/log/kvas-failover.log"

IFACE_VLESS="Proxy21"
IFACE_HYSTERIA="Proxy41"

init_failover_conf() {
    if [ ! -f "$FAILOVER_CONF" ]; then
        cat > "$FAILOVER_CONF" << 'EOF'
FAILOVER_MODE=failover
PRIMARY=vless
SECONDARY=hysteria
CHECK_INTERVAL=30
FAIL_THRESHOLD=2
PROBE_URL1=https://2ip.io
PROBE_URL2=https://ifconfig.me
AUTO_START=yes
EOF
    fi
}

# канон имени канала: desc из inface_equals (поле 3, может быть в кавычках) →
# токен, как его отдаёт get_active_iface (vless/hysteria/awg); иначе как есть.
# Чинит старые conf, где primary/secondary/tertiary = desc (Kvas-proxy-awg и т.п.)
# и активный канал (awg) с ним не совпадал → флап «возврат на primary».
_fo_canon() {
    local _c=""
    [ -n "$1" ] || return 0
    _c=$(awk -F'|' -v d="\"$1\"" '$3==d {print $1; exit}' "${INFACE_NAMES_FILE}" 2>/dev/null)
    [ -z "$_c" ] && _c=$(awk -F'|' -v d="$1" '$3==d {print $1; exit}' "${INFACE_NAMES_FILE}" 2>/dev/null)
    case "$_c" in
        Proxy21) printf 'vless' ;;
        Proxy41) printf 'hysteria' ;;
        Proxy42) printf 'awg' ;;
        *) printf '%s' "$1" ;;
    esac
}

load_failover_conf() {
    init_failover_conf
    # Не используем source — имена каналов могут содержать спецсимволы (скобки и т.д.)
    FAILOVER_MODE=$(grep "^FAILOVER_MODE=" "$FAILOVER_CONF" 2>/dev/null | cut -d= -f2-)
    PRIMARY=$(grep "^PRIMARY=" "$FAILOVER_CONF" 2>/dev/null | cut -d= -f2-)
    SECONDARY=$(grep "^SECONDARY=" "$FAILOVER_CONF" 2>/dev/null | cut -d= -f2-)
    TERTIARY=$(grep "^TERTIARY=" "$FAILOVER_CONF" 2>/dev/null | cut -d= -f2-)
    CHECK_INTERVAL=$(grep "^CHECK_INTERVAL=" "$FAILOVER_CONF" 2>/dev/null | cut -d= -f2-)
    FAIL_THRESHOLD=$(grep "^FAIL_THRESHOLD=" "$FAILOVER_CONF" 2>/dev/null | cut -d= -f2-)
    AUTO_START=$(grep "^AUTO_START=" "$FAILOVER_CONF" 2>/dev/null | cut -d= -f2-)
    # v636: адреса проверки каналов (голый IP в ответе); дефолты — если в conf нет
    PROBE_URL1=$(grep "^PROBE_URL1=" "$FAILOVER_CONF" 2>/dev/null | cut -d= -f2-)
    PROBE_URL2=$(grep "^PROBE_URL2=" "$FAILOVER_CONF" 2>/dev/null | cut -d= -f2-)
    [ -z "$PROBE_URL1" ] && PROBE_URL1="https://2ip.io"
    [ -z "$PROBE_URL2" ] && PROBE_URL2="https://ifconfig.me"
    PRIMARY=$(_fo_canon "$PRIMARY")
    SECONDARY=$(_fo_canon "$SECONDARY")
    TERTIARY=$(_fo_canon "$TERTIARY")
    # conf мог быть записан старой версией (TERTIARY=desc=PRIMARY) — чистим на чтении
    [ "$TERTIARY" = "$PRIMARY" ] && TERTIARY=""
    [ "$TERTIARY" = "$SECONDARY" ] && TERTIARY=""
}

save_failover_conf() {
    init_failover_conf
    # Валидация: PRIMARY и SECONDARY не должны совпадать
    if [ "$PRIMARY" = "$SECONDARY" ]; then
        SECONDARY=""
    fi
    [ -z "$SECONDARY" ] && SECONDARY="manual"
    # TERTIARY не должен дублировать primary/secondary (дропдауны UI не валидируют)
    [ "$TERTIARY" = "$PRIMARY" ] && TERTIARY=""
    [ "$TERTIARY" = "$SECONDARY" ] && TERTIARY=""
    cat > "$FAILOVER_CONF" << EOF
FAILOVER_MODE=${FAILOVER_MODE:-failover}
PRIMARY=${PRIMARY:-vless}
SECONDARY=${SECONDARY:-manual}
TERTIARY=${TERTIARY:-}
CHECK_INTERVAL=${CHECK_INTERVAL:-15}
FAIL_THRESHOLD=${FAIL_THRESHOLD:-2}
PROBE_URL1=${PROBE_URL1:-https://2ip.io}
PROBE_URL2=${PROBE_URL2:-https://ifconfig.me}
AUTO_START=${AUTO_START:-yes}
EOF
}

# Автоопределение доступных VPN каналов
# Возвращает список имён через пробел
get_available_channels() {
    local channels=""
    # vless — если xray запущен
    if pidof xray >/dev/null 2>&1; then
        channels="$channels vless"
    fi
    # hysteria — если бинарник и конфиг есть
    if [ -f /opt/apps/kvas/hysteria/bin/hysteria ] && [ -f /opt/apps/kvas/hysteria/etc/conf/env.sh ]; then
        channels="$channels hysteria"
    fi
    # awg — если бинарник и конфиг есть
    if [ -f /opt/apps/kvas/awg/bin/wireproxy ] && [ -f /opt/apps/kvas/awg/etc/conf/env.sh ]; then
        channels="$channels awg"
    fi
    # Другие интерфейсы из inface_equals (кроме bridges и ethernet)
    while IFS='|' read -r cli ent desc rest; do
        [ -n "$ent" ] && [ -n "$desc" ] || continue
        case "$ent" in
            t2s*|ezcfg*|br*|eth*|ra*|apcli*) ;;
            *)
                local d=$(echo "$desc" | sed 's/^"//; s/"$//')
                [ -n "$d" ] && channels="$channels $d"
                ;;
        esac
    done < /opt/etc/inface_equals 2>/dev/null
    echo "$channels" | tr ' ' '\n' | grep -v '^$' | sort -u | tr '\n' ' '
}

# Интерактивный выбор каналов при 'kvas failover on'
interactive_setup_channels() {
    local available=$(get_available_channels)
    local count=$(echo "$available" | wc -w)
    
    # Если только 1 канал — без вопросов
    if [ "$count" -le 1 ]; then
        PRIMARY=$(echo "$available" | awk '{print $1}')
        [ -z "$PRIMARY" ] && PRIMARY="vless"
        SECONDARY="manual"
        echo "Доступен только один канал: $PRIMARY"
        return
    fi
    
    # Список каналов с номерами
    echo ""
    echo "Доступные каналы:"
    local n=0
    for ch in $available; do
        n=$((n + 1))
        echo "  $n. $ch"
    done
    echo ""
    
    # Выбор основного
    local active=$(get_active_iface)
    local default_num=1
    n=0
    for ch in $available; do
        n=$((n + 1))
        [ "$ch" = "$active" ] && default_num=$n
    done
    
    echo -n "Основной канал [1-$count, Enter=$default_num]: "
    read -r _choice
    [ -z "$_choice" ] && _choice=$default_num
    PRIMARY=$(echo "$available" | awk -v n="$_choice" '{print $n}')
    [ -z "$PRIMARY" ] && PRIMARY=$(echo "$available" | awk '{print $1}')
    
    # Выбор резервного
    if [ "$count" -ge 2 ]; then
        echo ""
        echo "Резервный канал (кроме $PRIMARY):"
        local rn=0
        for ch in $available; do
            [ "$ch" = "$PRIMARY" ] && continue
            rn=$((rn + 1))
            echo "  $rn. $ch"
        done
        echo -n "Выберите [1-$rn, Enter=пропустить]: "
        read -r _choice2
        if [ -n "$_choice2" ]; then
            local ri=0
            for ch in $available; do
                [ "$ch" = "$PRIMARY" ] && continue
                ri=$((ri + 1))
                [ "$ri" = "$_choice2" ] && { SECONDARY="$ch"; break; }
            done
        fi
    fi
    
    # Выбор второго резервного
    if [ "$count" -ge 3 ] && [ -n "$SECONDARY" ]; then
        echo ""
        echo "Второй резервный канал (кроме $PRIMARY и $SECONDARY):"
        local tn=0
        for ch in $available; do
            [ "$ch" = "$PRIMARY" ] || [ "$ch" = "$SECONDARY" ] && continue
            tn=$((tn + 1))
            echo "  $tn. $ch"
        done
        if [ "$tn" -gt 0 ]; then
            echo -n "Выберите [1-$tn, Enter=пропустить]: "
            read -r _choice3
            if [ -n "$_choice3" ]; then
                local ti=0
                for ch in $available; do
                    [ "$ch" = "$PRIMARY" ] || [ "$ch" = "$SECONDARY" ] && continue
                    ti=$((ti + 1))
                    [ "$ti" = "$_choice3" ] && { TERTIARY="$ch"; break; }
                done
            fi
        fi
    fi
    
    [ -z "$SECONDARY" ] && SECONDARY="manual"
    [ -z "$TERTIARY" ] && TERTIARY=""
    
    echo ""
    echo "Настроено: основной=$PRIMARY, резерв=$SECONDARY${TERTIARY:+, второй резерв=$TERTIARY}"
}

# Автонастройка (без вопросов) — для web UI и автоматического режима
auto_setup_channels() {
    local active=$(get_active_iface)
    local available=$(get_available_channels)
    
    if [ "$active" != "none" ]; then
        PRIMARY="$active"
    else
        PRIMARY=$(echo "$available" | awk '{print $1}')
        [ -z "$PRIMARY" ] && PRIMARY="vless"
    fi
    
    SECONDARY=""
    for ch in $available; do
        [ "$ch" != "$PRIMARY" ] && { SECONDARY="$ch"; break; }
    done
    
    TERTIARY=""
    if [ -n "$SECONDARY" ]; then
        for ch in $available; do
            [ "$ch" != "$PRIMARY" ] && [ "$ch" != "$SECONDARY" ] && { TERTIARY="$ch"; break; }
        done
    fi
    
    [ -z "$SECONDARY" ] && SECONDARY="manual"
}

# Получение интерфейса по имени протокола
get_iface() {
    case "$1" in
        vless)    echo "$IFACE_VLESS" ;;
        hysteria) echo "$IFACE_HYSTERIA" ;;
        *)
            # Произвольный интерфейс — ищем в inface_equals
            grep "|$1|" /opt/etc/inface_equals 2>/dev/null | head -1 | cut -d'|' -f1
            ;;
    esac
}

# Получение текущего активного интерфейса
get_active_iface() {
    local current_cli=$(get_config_value INFACE_CLI 2>/dev/null)
    local current_ent=$(get_config_value INFACE_ENT 2>/dev/null)
    
    if [ "$current_cli" = "$IFACE_VLESS" ]; then echo "vless"; return; fi
    if [ "$current_cli" = "$IFACE_HYSTERIA" ]; then echo "hysteria"; return; fi
    if [ "$current_cli" = "Proxy42" ]; then echo "awg"; return; fi
    
    # Для других интерфейсов — ищем по entware-имени в inface_equals
    if [ -n "$current_ent" ] && [ -n "$current_cli" ]; then
        local desc=$(grep "|${current_ent}|" /opt/etc/inface_equals 2>/dev/null | head -1 | cut -d'|' -f3 | sed 's/^"//; s/"$//')
        [ -n "$desc" ] && echo "$desc" || echo "$current_ent"
        return
    fi
    
    # Fallback: если config пуст, проверяем интерфейс по ip link
    if [ -n "$current_ent" ]; then
        /opt/sbin/ip link show "$current_ent" 2>/dev/null | grep -q '<.*UP' && {
            echo "$current_ent"
            return
        }
    fi
    
    echo "none"
}

# v636: ответ проверки должен быть голым IP (IPv4/IPv6), а не HTML/ошибкой curl.
# IPv6 — только hex+двоеточия (мин. 2): текст вида "curl: (7) Failed" отсекается.
_fo_valid_ip() {
    [ -n "$1" ] || return 1
    echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' && return 0
    case "$1" in
        *[!0-9a-fA-F:]*|*' '*|*'<'*) return 1 ;;
    esac
    local _cc=$(echo "$1" | tr -cd ':' | wc -c)
    [ "$_cc" -ge 2 ] 2>/dev/null
}

# Проверка vless через socks5
check_vless() {
    local test_ip=$(curl -s --connect-timeout 5 --max-time 15 -x "socks5://127.0.0.1:1097" "${PROBE_URL1:-https://2ip.io}" 2>/dev/null)
    if ! _fo_valid_ip "$test_ip"; then
        test_ip=$(curl -s --connect-timeout 10 --max-time 20 -x "socks5://127.0.0.1:1097" "${PROBE_URL2:-https://ifconfig.me}" 2>/dev/null)
    fi
    if _fo_valid_ip "$test_ip"; then
        VLESS_IP="$test_ip"
        return 0
    fi
    return 1
}

# Проверка hysteria через socks5
check_hysteria() {
    local env_conf="/opt/apps/kvas/hysteria/etc/conf/env.sh"
    [ -f "$env_conf" ] || return 1
    . "$env_conf"
    [ -z "$PROXY_LOCAL_IP" ] || [ -z "$PROXY_LOCAL_PORT_SOCKS" ] && return 1
    local test_ip=$(curl -s --connect-timeout 6 --max-time 15 -x "socks5://${PROXY_LOCAL_IP}:${PROXY_LOCAL_PORT_SOCKS}" "${PROBE_URL1:-https://2ip.io}" 2>/dev/null)
    if ! _fo_valid_ip "$test_ip"; then
        test_ip=$(curl -s --connect-timeout 10 --max-time 20 -x "socks5://${PROXY_LOCAL_IP}:${PROXY_LOCAL_PORT_SOCKS}" "${PROBE_URL2:-https://ifconfig.me}" 2>/dev/null)
    fi
    if _fo_valid_ip "$test_ip"; then
        HYSTERIA_IP="$test_ip"
        return 0
    fi
    return 1
}

# Проверка произвольного TUN-интерфейса через --interface
check_tun_interface() {
    local ent="$1"
    [ -z "$ent" ] && return 1
    local test_ip=$(curl -s --connect-timeout 5 --max-time 15 --interface "$ent" "${PROBE_URL1:-https://2ip.io}" 2>/dev/null)
    if ! _fo_valid_ip "$test_ip"; then
        test_ip=$(curl -s --connect-timeout 10 --max-time 20 --interface "$ent" "${PROBE_URL2:-https://ifconfig.me}" 2>/dev/null)
    fi
    if _fo_valid_ip "$test_ip"; then
        TUN_IP="$test_ip"
        return 0
    fi
    return 1
}

# Универсальная проверка протокола по имени (vless/hysteria/описание/cli/entware)
check_protocol() {
    local proto="$1"
    case "$proto" in
        vless)    check_vless ;;
        hysteria) check_hysteria ;;
        awg)      check_awg ;;
        *)
            # Произвольный интерфейс — ищем entware-имя
            # Поиск по: cli (поле 1), entware (поле 2), описание (поле 3 с/без кавычек)
            local ent=""
            # По cli имени
            ent=$(awk -F'|' -v name="$proto" '$1==name {print $2; exit}' /opt/etc/inface_equals 2>/dev/null)
            # По entware имени
            [ -z "$ent" ] && ent=$(awk -F'|' -v name="$proto" '$2==name {print $2; exit}' /opt/etc/inface_equals 2>/dev/null)
            # По описанию (с кавычками)
            [ -z "$ent" ] && ent=$(grep "\"${proto}\"" /opt/etc/inface_equals 2>/dev/null | head -1 | cut -d'|' -f2)
            # По описанию (без кавычек)
            [ -z "$ent" ] && ent=$(grep "$proto" /opt/etc/inface_equals 2>/dev/null | head -1 | cut -d'|' -f2)
            # Если entware имя совпадает с proto (передали nwg1 вместо описания)
            [ -z "$ent" ] && ent="$proto"
            check_tun_interface "$ent"
            ;;
    esac
}

# Переключение на указанный протокол/интерфейс
switch_to() {
    local proto="$1"
    local lockfile="/tmp/kvas-failover-switch.lock"
    local from=""
    from=$(get_active_iface 2>/dev/null)
    [ -z "$from" ] && from="unknown"
    
    # v639: атомарный lock через mkdir — проверка [ -f ] + запись была гонкой:
    # два демона проходили её одновременно → два фоновых блока → дубли истории
    if ! mkdir "$lockfile" 2>/dev/null; then
        local lock_age=$(( $(date +%s) - $(stat -c %Y "$lockfile" 2>/dev/null || echo 0) ))
        if [ "$lock_age" -lt 120 ]; then
            log_failover "Переключение уже в процессе (${lock_age}с), пропускаем"
            return 0
        fi
        rm -rf "$lockfile"
        if ! mkdir "$lockfile" 2>/dev/null; then
            log_failover "Переключение уже в процессе (гонка), пропускаем"
            return 0
        fi
    fi
    
    log_failover "Переключение на $proto..."
    
    # v636: история переключений пишется ПОСЛЕ факта (успешный vpn set),
    # а не до — иначе в истории копились намерения и дубли при повторных
    # чеках демона, пока активный интерфейс ещё не сменился.
    {
        sleep 10
        /opt/apps/kvas/bin/kvas vpn set "$proto" >> /opt/var/log/kvas-failover.log 2>&1
        _fo_sw_rc=$?
        if [ "$_fo_sw_rc" -eq 0 ]; then
            record_switch "$from" "$proto" "auto"
        else
            log_failover "Переключение на $proto не удалось (vpn set rc=${_fo_sw_rc}) — остаёмся на $from"
        fi
        rm -rf "$lockfile"
        rm -f "$FAILOVER_FAIL_COUNT_FILE" "$FAILOVER_SUCC_COUNT_FILE"
        if [ -f "$FAILOVER_FLAG" ]; then
            /opt/apps/kvas/bin/kvas failover start >> /opt/var/log/kvas-failover.log 2>&1
        fi
    } < /dev/null >> /opt/var/log/kvas-failover.log 2>&1 &
    
    stop_failover_daemon > /dev/null 2>&1
    exit 0
}

FAILOVER_HISTORY="/opt/var/log/kvas-failover-history.log"

record_switch() {
    local from="$1" to="$2" reason="${3:-auto}"
    mkdir -p /opt/var/log
    # v639: дедуп — идентичная запись (from|to|reason) младше 60с не пишется
    local body="${from}|${to}|${reason}"
    local last_body=$(tail -1 "$FAILOVER_HISTORY" 2>/dev/null | cut -d'|' -f2-)
    local now=$(date +%s)
    local prev=$(cat "${FAILOVER_HISTORY}.stamp" 2>/dev/null || echo 0)
    if [ "$last_body" = "$body" ] && [ $((now - prev)) -lt 60 ]; then
        log_failover "SWITCH dup suppressed (<60s): $body"
        return 0
    fi
    echo "$(date '+%Y-%m-%d %H:%M:%S')|${body}" >> "$FAILOVER_HISTORY"
    echo "$now" > "${FAILOVER_HISTORY}.stamp"
    tail -50 "$FAILOVER_HISTORY" > "${FAILOVER_HISTORY}.tmp" 2>/dev/null
    mv "${FAILOVER_HISTORY}.tmp" "$FAILOVER_HISTORY" 2>/dev/null
    log_failover "SWITCH: $from -> $to ($reason)"
    # friendly names for Telegram: Proxy21→vless, Proxy41→hysteria, Proxy42→AmneziaWG, t2s*→...
    local fdisp tdisp
    fdisp=$(printf '%s' "$from" | sed 's/^Proxy21$/vless/; s/^Proxy41$/hysteria/; s/^Proxy42$/AmneziaWG/; s/^t2s21$/vless/; s/^t2s41$/hysteria/; s/^t2s42$/AmneziaWG/')
    tdisp=$(printf '%s' "$to" | sed 's/^Proxy21$/vless/; s/^Proxy41$/hysteria/; s/^Proxy42$/AmneziaWG/; s/^t2s21$/vless/; s/^t2s41$/hysteria/; s/^t2s42$/AmneziaWG/')
    tg_notify failover "Переключение: ${fdisp} → ${tdisp} (${reason})"
}

log_failover() {
    local msg="$1"
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    mkdir -p /opt/var/log
    echo "[$timestamp] $msg" >> "$FAILOVER_LOG"
    tail -100 "$FAILOVER_LOG" > "${FAILOVER_LOG}.tmp" 2>/dev/null
    mv "${FAILOVER_LOG}.tmp" "$FAILOVER_LOG" 2>/dev/null
}

# Счётчик неудач текущего канала (для FAIL_THRESHOLD)
FAILOVER_FAIL_COUNT_FILE="/tmp/kvas-failover-failcount"

_fo_get_fail_count() {
    cat "$FAILOVER_FAIL_COUNT_FILE" 2>/dev/null || echo 0
}

_fo_set_fail_count() {
    echo "$1" > "$FAILOVER_FAIL_COUNT_FILE" 2>/dev/null
}

_fo_reset_fail_count() {
    rm -f "$FAILOVER_FAIL_COUNT_FILE" 2>/dev/null
}

# Проверка: набран ли порог неудач. Возвращает 0 (true) если порог достигнут.
# При FAIL_THRESHOLD<=1 — всегда true (поведение как раньше).
_fo_threshold_reached() {
    local thr="${FAIL_THRESHOLD:-2}"
    [ "$thr" -le 1 ] 2>/dev/null && return 0
    local n=$(_fo_get_fail_count)
    [ "$n" -ge "$thr" ] 2>/dev/null
}

# Вызывается при УСПЕШНОЙ проверке активного канала — сбрасывает счётчики
_fo_note_success() {
    _fo_reset_fail_count
    _fo_reset_succ_count
}

# Счётчик УСПЕХОВ проверки primary, когда активен резерв (для возврата).
# v636: возврат на primary — по FAIL_THRESHOLD успешных проверок подряд,
# симметрично уходу с primary (раньше возврат шёл по одной удачной пробе
# и при нестабильном primary получались флап-качели).
FAILOVER_SUCC_COUNT_FILE="/tmp/kvas-failover-succcount"

_fo_get_succ_count() {
    cat "$FAILOVER_SUCC_COUNT_FILE" 2>/dev/null || echo 0
}

_fo_set_succ_count() {
    echo "$1" > "$FAILOVER_SUCC_COUNT_FILE" 2>/dev/null
}

_fo_reset_succ_count() {
    rm -f "$FAILOVER_SUCC_COUNT_FILE" 2>/dev/null
}

# Возвращает 0 только когда набран порог успехов подряд — пора возвращаться
_fo_note_primary_ok() {
    local thr="${FAIL_THRESHOLD:-2}"
    local n=$(_fo_get_succ_count)
    n=$((n + 1))
    _fo_set_succ_count "$n"
    if [ "$thr" -le 1 ] 2>/dev/null; then
        log_failover "Порог возврата=1 — возвращаемся сразу (успех #$n)"
        return 0
    fi
    if [ "$n" -ge "$thr" ] 2>/dev/null; then
        log_failover "Порог возврата достигнут ($n/$thr) — возвращаемся на primary"
        return 0
    fi
    log_failover "PRIMARY отвечает ($n/$thr) — подтверждаем возврат"
    return 1
}

# Вызывается при НЕУДАЧНОЙ проверке — инкрементирует, логирует
# Возвращает 0 только если порог достигнут (можно переключать)
_fo_note_failure() {
    local thr="${FAIL_THRESHOLD:-2}"
    local n=$(_fo_get_fail_count)
    n=$((n + 1))
    _fo_set_fail_count "$n"
    if [ "$thr" -le 1 ] 2>/dev/null; then
        log_failover "Порог неудач=1 — переключаемся сразу (неудача #$n)"
        return 0
    fi
    if [ "$n" -ge "$thr" ] 2>/dev/null; then
        log_failover "Порог неудач достигнут ($n/$thr) — можно переключаться"
        return 0
    fi
    log_failover "Неудача $n/$thr — ждём следующей проверки"
    return 1
}

run_failover_check() {
    load_failover_conf
    
    [ "$FAILOVER_MODE" != "failover" ] && return 0
    
    local active=$(get_active_iface)
    local secondary="${SECONDARY:-manual}"
    local tertiary="${TERTIARY:-}"
    
    # Если active == PRIMARY — проверяем PRIMARY
    if [ "$active" = "$PRIMARY" ]; then
        if check_protocol "$PRIMARY"; then
            _fo_note_success
            return 0
        else
            log_failover "$PRIMARY недоступен."
            # Считаем неудачу; переключаемся только при достижении порога
            if ! _fo_note_failure; then
                return 0
            fi
            # Пробуем SECONDARY, потом TERTIARY
            if [ "$secondary" != "manual" ] && check_protocol "$secondary"; then
                log_failover "Переключение на $secondary..."
                _fo_reset_fail_count
                switch_to "$secondary"
            elif [ -n "$tertiary" ] && check_protocol "$tertiary"; then
                log_failover "Переключение на $tertiary (второй резерв)..."
                _fo_reset_fail_count
                switch_to "$tertiary"
            else
                log_failover "Ни один канал не доступен. Ожидаем."
            fi
            return 0
        fi
    fi
    
    # Если active == SECONDARY — проверяем можно ли вернуться на PRIMARY
    if [ "$active" = "$secondary" ]; then
        log_failover "Обнаружен $secondary. Проверяем $PRIMARY..."
        if check_protocol "$PRIMARY"; then
            # v636: возврат по порогу успехов подряд (FAIL_THRESHOLD)
            if _fo_note_primary_ok; then
                log_failover "$PRIMARY восстановлен. Возврат."
                switch_to "$PRIMARY"
            fi
        else
            _fo_reset_succ_count
            log_failover "$PRIMARY всё ещё недоступен."
        fi
        return 0
    fi
    
    # Если active == TERTIARY — проверяем PRIMARY и SECONDARY
    if [ -n "$tertiary" ] && [ "$active" = "$tertiary" ]; then
        log_failover "Активен $tertiary (второй резерв). Проверяем выше..."
        if check_protocol "$PRIMARY"; then
            # v636: возврат по порогу успехов подряд (FAIL_THRESHOLD)
            if _fo_note_primary_ok; then
                log_failover "$PRIMARY восстановлен. Возврат."
                switch_to "$PRIMARY"
            fi
        else
            _fo_reset_succ_count
            if [ "$secondary" != "manual" ] && check_protocol "$secondary"; then
                log_failover "$secondary восстановлен. Переключение."
                switch_to "$secondary"
            else
                log_failover "Остаёмся на $tertiary."
            fi
        fi
        return 0
    fi
    
    # Если active == none — пытаемся запустить PRIMARY, потом SECONDARY, потом TERTIARY
    if [ "$active" = "none" ]; then
        log_failover "Нет активного интерфейса. Проверяем каналы..."
        if check_protocol "$PRIMARY"; then
            log_failover "$PRIMARY доступен. Переключение."
            switch_to "$PRIMARY"
        elif [ "$secondary" != "manual" ] && check_protocol "$secondary"; then
            log_failover "Переключение на $secondary..."
            switch_to "$secondary"
        elif [ -n "$tertiary" ] && check_protocol "$tertiary"; then
            log_failover "Переключение на $tertiary..."
            switch_to "$tertiary"
        else
            log_failover "Ни один канал не доступен. Ожидаем."
        fi
        return 0
    fi
    
    # Если active — какой-то другой интерфейс (не PRIMARY, не SECONDARY, не TERTIARY)
    # v640: раньше оставляли как есть без проверок — мёртвый «чужой» интерфейс
    # висел в конфиге вечно и демон вообще не проверял каналы (переключений не было).
    # Теперь: жив — не трогаем (ручной выбор); отвалился — перебираем каналы,
    # автовозврата на чужой интерфейс нет (switch_to перезаписывает PRIMARY,
    # возврат только вручную: kvas vpn set <iface>).
    local cur_ent=$(get_config_value INFACE_ENT 2>/dev/null)
    local cur_alive=0
    if [ -n "$cur_ent" ] && /opt/sbin/ip link show "$cur_ent" 2>/dev/null | grep -q '<.*UP'; then
        if check_tun_interface "$cur_ent"; then
            cur_alive=1
        fi
    fi
    if [ "$cur_alive" = 1 ]; then
        log_failover "Активен $active (не primary/secondary/tertiary) и работает. Оставляем как есть."
        return 0
    fi
    log_failover "Активный $active вне каналов недоступен. Проверяем каналы..."
    if check_protocol "$PRIMARY"; then
        log_failover "$PRIMARY доступен. Переключение."
        switch_to "$PRIMARY"
    elif [ "$secondary" != "manual" ] && check_protocol "$secondary"; then
        log_failover "Переключение на $secondary..."
        switch_to "$secondary"
    elif [ -n "$tertiary" ] && check_protocol "$tertiary"; then
        log_failover "Переключение на $tertiary..."
        switch_to "$tertiary"
    else
        log_failover "Ни один канал не доступен. Ожидаем."
    fi
    return 0
}

start_failover_daemon() {
    load_failover_conf
    log_failover "Демон запущен (primary=$PRIMARY, secondary=$SECONDARY, интервал=${CHECK_INTERVAL}с)"
    while true; do
        run_failover_check >> /dev/null 2>&1
        sleep "$CHECK_INTERVAL"
    done
}

stop_failover_daemon() {
    local pidfile="/var/run/kvas-failover.pid"
    if [ -f "$pidfile" ]; then
        kill $(cat "$pidfile" 2>/dev/null) 2>/dev/null
        rm -f "$pidfile"
        echo "Демон failover остановлен"
    fi
}

show_failover_status() {
    load_failover_conf
    
    echo "=== Статус автопереключения ==="
    echo "Режим: $FAILOVER_MODE"
    echo "Основное: $PRIMARY"
    echo "Резерв: ${SECONDARY:-manual}"
    [ -n "$TERTIARY" ] && echo "Второй резерв: $TERTIARY"
    echo "Интервал: $CHECK_INTERVAL сек"
    echo "Порог: $FAIL_THRESHOLD"
    echo "Адрес проверки 1: $PROBE_URL1"
    echo "Адрес проверки 2: $PROBE_URL2"
    echo ""
    
    local active=$(get_active_iface)
    echo "Активный: $active"
    echo ""
    echo "Проверка всех каналов:"
    
    # Проверяем ВСЕ доступные каналы
    local available=$(get_available_channels)
    for ch in $available; do
        _show_channel_status "$ch"
    done
    
    echo ""
    local pidfile="/var/run/kvas-failover.pid"
    if [ -f "$pidfile" ] && kill -0 $(cat "$pidfile" 2>/dev/null) 2>/dev/null; then
        echo "Демон: запущен (PID: $(cat "$pidfile"))"
    else
        echo "Демон: остановлен"
    fi
    
    [ -f "$FAILOVER_LOG" ] && {
        echo ""
        echo "Последние события:"
        tail -5 "$FAILOVER_LOG" | sed 's/^/  /'
    }
}

# Показать статус канала с различением типов
_show_channel_status() {
    local ch="$1"
    local _ent=""
    
    # Определяем тип и проверяем запущен ли
    case "$ch" in
        vless)
            if ! pidof xray >/dev/null 2>&1; then
                ready "$ch" && when_alert "ОСТАНОВЛЕН"
                return
            fi
            ;;
        hysteria)
            if ! pidof hysteria >/dev/null 2>&1; then
                ready "$ch" && when_alert "ОСТАНОВЛЕН"
                return
            fi
            ;;
        awg)
            if [ ! -f /var/run/wireproxy.pid ] || ! kill -0 "$(cat /var/run/wireproxy.pid 2>/dev/null)" 2>/dev/null; then
                ready "$ch" && when_alert "ОСТАНОВЛЕН"
                return
            fi
            ;;
        *)
            # TUN интерфейс — ищем entware-имя
            _ent=$(grep "$ch" /opt/etc/inface_equals 2>/dev/null | head -1 | cut -d'|' -f2)
            [ -z "$_ent" ] && _ent="$ch"
            if ! /opt/sbin/ip link show "$_ent" 2>/dev/null | grep -q '<.*UP'; then
                ready "$ch" && when_bad "ИНТЕРФЕЙС DOWN"
                return
            fi
            ;;
    esac
    
    # Сервис запущен — проверяем интернет
    if check_protocol "$ch"; then
        local ip=""
        case "$ch" in
            vless) ip="$VLESS_IP" ;;
            hysteria) ip="$HYSTERIA_IP" ;;
            awg) ip="$AWG_IP" ;;
            *) ip="$TUN_IP" ;;
        esac
        ready "$ch" && when_ok "РАБОТАЕТ (IP: ${ip:-?})"
    else
        ready "$ch" && when_alert "НЕ ОТВЕЧАЕТ"
    fi
}

cmd_failover() {
    case "${1}" in
        on)
            load_failover_conf
            FAILOVER_MODE=failover
            touch "$FAILOVER_FLAG"
            # Интерактивный выбор если есть TTY, иначе автонастройка
            if [ -t 0 ]; then
                interactive_setup_channels
            else
                auto_setup_channels
            fi
            save_failover_conf
            echo "Автопереключение включено"
            echo "  Основное: $PRIMARY"
            echo "  Резерв: $SECONDARY"
            [ -n "$TERTIARY" ] && echo "  Второй резерв: $TERTIARY"
            mkdir -p /opt/var/log
            local pidfile="/var/run/kvas-failover.pid"
            if [ -f "$pidfile" ] && kill -0 $(cat "$pidfile" 2>/dev/null) 2>/dev/null; then
                echo "Демон уже запущен"
            else
                start_failover_daemon &
                echo $! > "$pidfile"
                echo "Демон запущен (PID: $!)"
            fi
            ;;
        off)
            load_failover_conf
            FAILOVER_MODE=manual
            rm -f "$FAILOVER_FLAG"
            save_failover_conf
            stop_failover_daemon
            echo "Автопереключение отключено"
            ;;
        primary)
            load_failover_conf
            PRIMARY="${2}"
            save_failover_conf
            echo "Основное подключение: $PRIMARY"
            ;;
        secondary)
            load_failover_conf
            SECONDARY="${2}"
            save_failover_conf
            echo "Резервное подключение: $SECONDARY"
            ;;
        start)
            local pidfile="/var/run/kvas-failover.pid"
            if [ -f "$pidfile" ] && kill -0 $(cat "$pidfile" 2>/dev/null) 2>/dev/null; then
                echo "Демон уже запущен"
            else
                start_failover_daemon > /dev/null 2>&1 &
                echo $! > "$pidfile"
                echo "Демон запущен"
            fi
            ;;
        stop)
            stop_failover_daemon
            ;;
        status)
            show_failover_status
            ;;
        set)
            case "${2}" in
                primary)
                    load_failover_conf
                    PRIMARY="${3}"
                    save_failover_conf
                    echo "Основное: $PRIMARY"
                    ;;
                secondary)
                    load_failover_conf
                    SECONDARY="${3}"
                    save_failover_conf
                    echo "Резерв: $SECONDARY"
                    ;;
                tertiary)
                    load_failover_conf
                    TERTIARY="${3}"
                    save_failover_conf
                    echo "Второй резерв: $TERTIARY"
                    ;;
                interval)
                    case "${3}" in
                        ''|*[!0-9]*|0*)
                            echo "Интервал: целое число секунд >= 1"
                            return 1
                            ;;
                    esac
                    load_failover_conf
                    CHECK_INTERVAL="${3}"
                    save_failover_conf
                    echo "Интервал: $CHECK_INTERVAL сек"
                    ;;
                threshold)
                    case "${3}" in
                        ''|*[!0-9]*|0*)
                            echo "Порог: целое число >= 1"
                            return 1
                            ;;
                    esac
                    load_failover_conf
                    FAIL_THRESHOLD="${3}"
                    save_failover_conf
                    echo "Порог: $FAIL_THRESHOLD"
                    ;;
                probe1|probe2)
                    case "${3}" in
                        http://*|https://*) ;;
                        *)
                            echo "Адрес проверки должен начинаться с http:// или https://"
                            return 1
                            ;;
                    esac
                    load_failover_conf
                    if [ "${2}" = "probe1" ]; then
                        PROBE_URL1="${3}"
                    else
                        PROBE_URL2="${3}"
                    fi
                    save_failover_conf
                    echo "Адрес проверки ${2#probe}: ${3}"
                    ;;
                *)
                    echo "Использование: kvas failover set {primary|secondary|interval|threshold|probe1|probe2} [значение]"
                    ;;
            esac
            ;;
        log)
            [ -f "$FAILOVER_LOG" ] && tail -${2:-20} "$FAILOVER_LOG" || echo "Лог пуст"
            ;;
        test)
            echo "=== Тест failover ==="
            load_failover_conf
            echo "Проверяем $PRIMARY..."
            if check_protocol "$PRIMARY"; then
                local ip=""; case "$PRIMARY" in vless) ip="$VLESS_IP" ;; hysteria) ip="$HYSTERIA_IP" ;; *) ip="$TUN_IP" ;; esac
                echo "  $PRIMARY: работает (IP: ${ip:-?})"
            else
                echo "  $PRIMARY: НЕ работает"
            fi
            echo "Проверяем ${SECONDARY:-hysteria}..."
            if check_protocol "${SECONDARY:-hysteria}"; then
                local ip=""; case "${SECONDARY:-hysteria}" in vless) ip="$VLESS_IP" ;; hysteria) ip="$HYSTERIA_IP" ;; *) ip="$TUN_IP" ;; esac
                echo "  ${SECONDARY:-hysteria}: работает (IP: ${ip:-?})"
            else
                echo "  ${SECONDARY:-hysteria}: НЕ работает"
            fi
            echo ""
            echo "Активный: $(get_active_iface)"
            ;;
        *)
            echo "Использование: kvas failover {on|off|start|stop|status|set|log|test}"
            echo ""
            echo "Команды:"
            echo "  on                    - включить автопереключение"
            echo "  off                   - отключить"
            echo "  start                 - запустить демон"
            echo "  stop                  - остановить демон"
            echo "  status                - статус"
            echo "  primary <name>        - основной канал (vless|hysteria|<interface>)"
            echo "  secondary <name>      - резервный канал (vless|hysteria|<interface>)"
            echo "  set primary <name>    - установить основной"
            echo "  set secondary <name>  - установить резервный"
            echo "  set interval <N>      - интервал (сек, >= 1)"
            echo "  set threshold <N>     - порог ошибок/успехов (>= 1)"
            echo "  set probe1 <url>      - адрес проверки 1 (должен отдавать голый IP)"
            echo "  set probe2 <url>      - адрес проверки 2 (фолбэк)"
            echo "  log [N]               - последние N записей"
            echo "  test                  - тест каналов"
            ;;
    esac
}
