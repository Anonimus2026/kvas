#!/bin/sh
# ------------------------------------------------------------------------------------------
#
#	Список 2 — вторая полоса маршрутизации (beta-10, v612)
#
#	Домены и IP/CIDR из /opt/etc/kvas2.list идут через выбранный тоннель
#	(LANE2_TUNNEL: current|vless|hysteria|awg), минуя основной список:
#	PREROUTING → KVAS_MARK2 → mark 0xd1001 → ip rule 1777 → таблица 201.
#	При недоступности тоннеля таблица 201 очищается — трафик уходит
#	в таблицу 200 (правило фоллбэка 1779).
#
#	Команды: kvas list2 [add|del|list|tunnel|tunnel-list|status] [значение]
#
# ------------------------------------------------------------------------------------------

# файл списка создаётся при первом обращении
cmd_list2__ensure_file() {
	[ -f "${KVAS_LIST2_FILE}" ] && return
	mkdir -p "$(dirname "${KVAS_LIST2_FILE}")" 2>/dev/null
	touch "${KVAS_LIST2_FILE}" 2>/dev/null
	chmod 666 "${KVAS_LIST2_FILE}" 2>/dev/null
}

cmd_list2__ensure_ipset() {
	/opt/sbin/ipset -exist create "${IPSET_TABLE2_NAME}" hash:net family inet &>/dev/null || true
}

# одно значение: домен, IP, диапазон или CIDR (без пробелов)
cmd_list2__normalize() {
	local host="$1"
	host=$(echo "${host}" | sed 's/#.*$//g' | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')
	echo "${host}"
}

cmd_list2__is_static() {
	echo "${1}" | grep -qE -- "$(get_regexp_ip_or_range)"
}

cmd_list2__is_domain() {
	echo "${1}" | grep -qE '^[A-Za-z0-9*][A-Za-z0-9.*_-]*(\.[A-Za-z0-9*_-]+)+$'
}

# список настроенных тоннелей lane2 (current всегда доступен;
# плюс тоннели, поднятые в самом Keenetic — OpenVPN/SSTP/WG/... — как у основного списка)
cmd_list2__available() {
	local out="current"
	local cli _rest
	grep -q "^Proxy21|" "${INFACE_NAMES_FILE}" 2>/dev/null && out="${out} vless"
	grep -q "^Proxy41|" "${INFACE_NAMES_FILE}" 2>/dev/null && out="${out} hysteria"
	grep -q "^Proxy42|" "${INFACE_NAMES_FILE}" 2>/dev/null && out="${out} awg"
	if [ -f "${INFACE_NAMES_FILE}" ]; then
		while IFS='|' read -r cli _rest; do
			case "${cli}" in
				''|shadowsocks|Proxy21|proxy21|Proxy41|proxy41|Proxy42|proxy42) continue ;;
			esac
			case " ${out} " in *" ${cli} "*) continue ;; esac
			out="${out} ${cli}"
		done < "${INFACE_NAMES_FILE}"
	fi
	echo "${out}"
}

# человекочитаемое имя тоннеля (описание из inface_equals, как в основном списке)
cmd_list2__label() {
	local tun="$1" cli ent desc
	case "${tun}" in
		vless)    cli='Proxy21' ;;
		hysteria) cli='Proxy41' ;;
		awg)      cli='Proxy42' ;;
		current)
			ent=$(get_config_value 'INFACE_ENT')
			desc=$(awk -F'|' -v e="${ent}" '$2==e {print $3; exit}' "${INFACE_NAMES_FILE}" 2>/dev/null)
			if [ -n "${desc}" ] ; then
				echo "текущий (${desc})"
			else
				echo "текущий"
			fi
			return ;;
		*)        cli="${tun}" ;;
	esac
	desc=$(awk -F'|' -v c="${cli}" '$1==c {print $3; exit}' "${INFACE_NAMES_FILE}" 2>/dev/null)
	[ -n "${desc}" ] || desc=$(awk -F'|' -v c="${cli}" '$1==c {print $2; exit}' "${INFACE_NAMES_FILE}" 2>/dev/null)
	[ -n "${desc}" ] || desc="${tun}"
	echo "${desc}"
}

cmd_list2__count() {
	cmd_list2__ensure_file
	local c
	c=$(grep -cvE '^[[:space:]]*(#|$)' "${KVAS_LIST2_FILE}" 2>/dev/null)
	echo "${c:-0}"
}

# быстрый резолв домена в ipset Списка 2 (dnsmasq сделает это и впредь)
cmd_list2__fill_domain() {
	local host="${1//\*/}"
	local ip_list=$(dns__get_ips_by_domain "${host}")
	[ -z "${ip_list}" ] && return
	cmd_list2__ensure_ipset
	IFS=$'\n'
	for domain_ip in ${ip_list}; do
		/opt/sbin/ipset -exist add "${IPSET_TABLE2_NAME}" "${domain_ip}" 2>/dev/null || true
		cmd_list2__flush_ct "${domain_ip}"
	done
}

cmd_list2__drop_domain() {
	local host="${1//\*/}"
	local ip_list=$(dns__get_ips_by_domain "${host}")
	[ -z "${ip_list}" ] && return
	IFS=$'\n'
	for domain_ip in ${ip_list}; do
		/opt/sbin/ipset del "${IPSET_TABLE2_NAME}" "${domain_ip}" 2>/dev/null || true
	done
}

# пересборка dnsmasq-директив ipset=/домен/KVAS_LIST2 + HUP
cmd_list2__regen_dns() {
	/opt/apps/kvas/bin/main/dnsmasq >/dev/null 2>&1
	kill -HUP "$(pidof dnsmasq)" 2>/dev/null
}

# сброс conntrack для IP (реализация — ct__flush_ips в libs/main)
cmd_list2__flush_ct() {
	ct__flush_ips "$@"
}

# применить Список 2 целиком: ipset, dns, цепочка, вход, таблица 201
cmd_list2__apply() {
	cmd_list2__ensure_file
	cmd_list2__ensure_ipset
	/opt/apps/kvas/bin/main/ipset >/dev/null 2>&1
	cmd_list2__regen_dns
	ip4__mark2__create_chain
	ip4__mark2__add_routing_for_home
	ip4__route2__add_table
}

# полная пересборка ipset Списка 2 из kvas2.list (статика + резолв каждого домена)
cmd_list2__rebuild() {
	cmd_list2__ensure_file
	cmd_list2__ensure_ipset
	# старые участники: сбросить их conntrack, затем очистить набор —
	# точечный ipset del промахивается, когда CDN отдаёт при удалении другие IP
	local member
	member=$(/opt/sbin/ipset -L "${IPSET_TABLE2_NAME}" 2>/dev/null | awk '/^Members:/{f=1;next} f && NF{print $1}')
	if [ -n "${member}" ] ; then
		cmd_list2__flush_ct ${member}
	fi
	# и всё ещё помеченные меткой полосы, но уже вычищенные из набора
	# (бывает: запись успела уйти из ipset, а живое соединение держит CONNMARK)
	if command -v conntrack >/dev/null 2>&1 ; then
		local mark_hex="${MARK2_NUM:-0xd1001}"
		mark_hex="${mark_hex#0x}"
		local stale
		stale=$(conntrack -L 2>/dev/null | awk -v m="${mark_hex}" 'index($0,m){for(i=1;i<=NF;i++) if($i ~ /^dst=/){print substr($i,5); break}}')
		if [ -n "${stale}" ] ; then
			cmd_list2__flush_ct ${stale}
		fi
	fi
	/opt/sbin/ipset flush "${IPSET_TABLE2_NAME}" 2>/dev/null || true
	cmd_list2__apply
	# оставшиеся записи заново: статику перечитает main/ipset, домены — здесь
	local line host
	while IFS= read -r line || [ -n "${line}" ] ; do
		case "${line}" in
			''|'#'*|'-'*) continue ;;
		esac
		host=$(cmd_list2__normalize "${line}")
		if cmd_list2__is_static "${host}" ; then
			continue
		fi
		if cmd_list2__is_domain "${host}" ; then
			cmd_list2__fill_domain "${host}"
		fi
	done < "${KVAS_LIST2_FILE}"
}

cmd_list2_list() {
	local search="${1}"
	cmd_list2__ensure_file
	if [ ! -s "${KVAS_LIST2_FILE}" ] ; then
		echo "Список 2 пуст. Добавить: kvas list2 add <домен|IP/CIDR>"
		return
	fi
	if [ -n "${search}" ] ; then
		grep "${search}" "${KVAS_LIST2_FILE}" || echo "Совпадений нет."
	else
		echo "Список 2 (вторая полоса, тоннель: $(ip4__lane2__get_tunnel)):"
		grep -vE '^[[:space:]]*(#|$)' "${KVAS_LIST2_FILE}" 2>/dev/null
	fi
}

cmd_list2_add() {
	local host=$(cmd_list2__normalize "${1}")
	if [ -z "${host}" ] ; then
		error "Не указано значение для добавления в Список 2"
		return 1
	fi
	if ! cmd_list2__is_static "${host}" && ! cmd_list2__is_domain "${host}" ; then
		error "Некорректное значение '${host}'. Ожидается домен, IP, диапазон или CIDR."
		return 1
	fi

	cmd_list2__ensure_file
	if grep -Fxq "${host}" "${KVAS_LIST2_FILE}" 2>/dev/null ; then
		warning "'${host}' уже есть в Списке 2"
		return 0
	fi

	echo "${host}" >> "${KVAS_LIST2_FILE}"
	chmod 666 "${KVAS_LIST2_FILE}" 2>/dev/null
	echo "Добавлено в Список 2: ${host}"

	if cmd_list2__is_static "${host}" ; then
		cmd_list2__ensure_ipset
		/opt/sbin/ipset -exist add "${IPSET_TABLE2_NAME}" "${host}" timeout 0 2>/dev/null \
		 || error "Не удалось добавить ${host} в ipset ${IPSET_TABLE2_NAME}"
	else
		cmd_list2__fill_domain "${host}"
		cmd_list2__regen_dns
	fi
}

cmd_list2_del() {
	local host=$(cmd_list2__normalize "${1}")
	if [ -z "${host}" ] ; then
		error "Не указано значение для удаления из Списка 2"
		return 1
	fi

	cmd_list2__ensure_file
	if ! grep -Fxq "${host}" "${KVAS_LIST2_FILE}" 2>/dev/null ; then
		if ! grep -Fxq "*.${host}" "${KVAS_LIST2_FILE}" 2>/dev/null ; then
			warning "'${host}' не найден в Списке 2"
			return 1
		fi
		host="*.${host}"
	fi

	# grep -v возвращает 1, когда непустых строк не осталось (единственная запись) — это не ошибка
	grep -Fxv "${host}" "${KVAS_LIST2_FILE}" > "${KVAS_LIST2_FILE}.tmp" 2>/dev/null
	local grep_rc=$?
	if [ "${grep_rc}" -le 1 ] && [ -f "${KVAS_LIST2_FILE}.tmp" ] ; then
		mv -f "${KVAS_LIST2_FILE}.tmp" "${KVAS_LIST2_FILE}"
	else
		rm -f "${KVAS_LIST2_FILE}.tmp"
		error "Не удалось обновить ${KVAS_LIST2_FILE}"
		return 1
	fi
	chmod 666 "${KVAS_LIST2_FILE}" 2>/dev/null
	echo "Удалено из Списка 2: ${host}"

	# пересборка целиком: убрать запись из ipset со всеми её IP
	# (включая промахнувшиеся при точечном удалении) + сброс conntrack
	cmd_list2__rebuild
}

cmd_list2_tunnel_list() {
	local current=$(ip4__lane2__get_tunnel)
	local tun iface
	for tun in $(cmd_list2__available) ; do
		iface=$(ip4__lane2__get_iface "${tun}")
		if [ "${tun}" = "${current}" ] ; then
			echo "* ${tun} — $(cmd_list2__label "${tun}") (интерфейс: ${iface:-—}) — выбран"
		else
			echo "  ${tun} — $(cmd_list2__label "${tun}") (интерфейс: ${iface:-—})"
		fi
	done
}

cmd_list2_tunnel() {
	local tun="$1"
	if [ -z "${tun}" ] ; then
		cmd_list2_tunnel_list
		return
	fi
	case "${tun}" in
		current|vless|hysteria|awg) ;;
		*)
			# тоннели Keenetic (sstp/openconnect/...) — по списку inface_equals
			if ! echo " $(cmd_list2__available) " | grep -qF " ${tun} " ; then
				error "Неизвестный тоннель '${tun}'. Доступно: $(cmd_list2__available)"
				return 1
			fi
			;;
	esac
	if ! echo " $(cmd_list2__available) " | grep -qF " ${tun} " ; then
		error "Тоннель '${tun}' не настроен"
		return 1
	fi

	set_config_value 'LANE2_TUNNEL' "${tun}"
	ip4__route2__add_table
	ip4__route__flush_cache
	echo "Тоннель Списка 2: ${tun} — $(cmd_list2__label "${tun}") (интерфейс: $(ip4__lane2__get_iface "${tun}"))"
}

# статус в формате key=value (читает Web UI)
cmd_list2_status() {
	cmd_list2__ensure_file
	local tun=$(ip4__lane2__get_tunnel)
	local iface=$(ip4__lane2__get_iface "${tun}")
	local up=no
	ip4__lane2__is_iface_up "${iface}" && up=yes
	echo "tunnel=${tun}"
	echo "iface=${iface}"
	echo "iface_up=${up}"
	echo "available=$(cmd_list2__available)"
	echo "entries=$(cmd_list2__count)"
	echo "mark=${MARK2_NUM}"
	echo "table=${ROUTE_TABLE2_ID}"
	# подписи для Web UI: label.<токен>=<описание>
	local t
	for t in $(cmd_list2__available) ; do
		echo "label.${t}=$(cmd_list2__label "${t}")"
	done
}
