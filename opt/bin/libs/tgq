#!/bin/sh
# Telegram queue helper — единая точка истины (P.8)
TG_CONF="${TG_CONF:-/opt/etc/kvas.conf}"
TG_QUEUE_DIR=/opt/var/kvas
TG_QUEUE="${TG_QUEUE_DIR}/tg.queue"

tg_conf_get(){ sed -n "s/^$1=//p" "${TG_CONF}" 2>/dev/null | head -1; }

# Quiet hours: TG_QUIET_START/TG_QUIET_END = HH:MM (пусто = off).
# true, если сейчас ночное «тихое» окно (в т.ч. через полночь).
tg_quiet_active(){
	_qs=$(tg_conf_get TG_QUIET_START)
	_qe=$(tg_conf_get TG_QUIET_END)
	[ -n "${_qs}" ] && [ -n "${_qe}" ] || return 1
	_qs=$(printf '%s' "${_qs}" | tr -cd '0-9:')
	_qe=$(printf '%s' "${_qe}" | tr -cd '0-9:')
	case "${_qs}" in *:*) ;; *) return 1 ;; esac
	case "${_qe}" in *:*) ;; *) return 1 ;; esac
	_tmin(){ # HH:MM или HHMM → минуты с полуночи; мусор → 0
		_t=$(printf '%s' "$1" | tr -cd '0-9:')
		case "${_t}" in
			*:*) _h=${_t%%:*}; _m=${_t##*:} ;;
			[0-9][0-9][0-9][0-9]) _h=${_t%??}; _m=${_t#??} ;;
			[0-9][0-9][0-9]) _h=${_t%??}; _m=${_t#?} ;;
			[0-9][0-9]) _h=${_t}; _m=0 ;;
			[0-9]) _h=${_t}; _m=0 ;;
			*) _h=0; _m=0 ;;
		esac
		# strip leading zeros (POSIX $((09)) is invalid)
		_h=$(printf '%s' "${_h}" | tr -cd '0-9' | sed 's/^0*//'); [ -n "${_h}" ] || _h=0
		_m=$(printf '%s' "${_m}" | tr -cd '0-9' | sed 's/^0*//'); [ -n "${_m}" ] || _m=0
		[ "${_h}" -gt 23 ] 2>/dev/null && _h=23
		[ "${_m}" -gt 59 ] 2>/dev/null && _m=59
		printf '%s' $(( ${_h} * 60 + ${_m} ))
	}
	_sm=$(_tmin "${_qs}")
	_em=$(_tmin "${_qe}")
	[ "${_sm}" = "${_em}" ] && return 1
	_now=$(date +%H%M)
	_nm=$(_tmin "${_now}")
	if [ "${_sm}" -lt "${_em}" ]; then
		[ "${_nm}" -ge "${_sm}" ] && [ "${_nm}" -lt "${_em}" ]
	else
		[ "${_nm}" -ge "${_sm}" ] || [ "${_nm}" -lt "${_em}" ]
	fi
}

tg_socks_port(){
	case "$(sed -n 's/^INFACE_CLI=//p' /opt/etc/kvas.conf 2>/dev/null | head -1)" in
		*Proxy21*|*t2s21*|*vless*) echo 1097 ;;
		*Proxy41*|*t2s41*|*hysteria*) echo 10808 ;;
		*Proxy42*|*t2s42*|*awg*) echo 10818 ;;
		*) echo "" ;;
	esac
}

# Запрос в Telegram API: сначала через локальный SOCKS тоннеля (API заблокирован
# напрямую), затем через запасные socks-порты, затем напрямую.
# Аргументы: tg_curl URL [доп. аргументы curl...]
# TG_CURL_MAX — общий лимит времени curl (long-poll getUpdates задаёт 30)
# ВАЖНО: без $() вокруг curl — subshell наследует cmdline скрипта = «второй» процесс в ps.
tg_curl(){
	_tg_url="$1"; shift
	_tg_tmp="/tmp/.tgc.$$"
	_p=$(tg_socks_port)
	[ -n "${_p}" ] || _p=1097
	rm -f "${_tg_tmp}" 2>/dev/null
	curl -s --max-time "${TG_CURL_MAX:-15}" -o "${_tg_tmp}" "$@" -x "socks5h://127.0.0.1:${_p}" "${_tg_url}" 2>/dev/null
	if [ -s "${_tg_tmp}" ]; then
		cat "${_tg_tmp}"
		rm -f "${_tg_tmp}"
		return 0
	fi
	for _q in 1097 10808 10818; do
		[ "${_q}" = "${_p}" ] && continue
		rm -f "${_tg_tmp}" 2>/dev/null
		curl -s --max-time "${TG_CURL_MAX:-12}" -o "${_tg_tmp}" "$@" -x "socks5h://127.0.0.1:${_q}" "${_tg_url}" 2>/dev/null
		if [ -s "${_tg_tmp}" ]; then
			cat "${_tg_tmp}"
			rm -f "${_tg_tmp}"
			return 0
		fi
	done
	rm -f "${_tg_tmp}" 2>/dev/null
	curl -s --max-time "${TG_CURL_MAX:-12}" -o "${_tg_tmp}" "$@" "${_tg_url}" 2>/dev/null
	cat "${_tg_tmp}" 2>/dev/null
	rm -f "${_tg_tmp}" 2>/dev/null
	return 0
}

# Как tg_curl, но пишет в файл (-o), без $() в вызывающем sh:
# long-poll $(tg_curl ...) держал subshell с тем же cmdline = «второй» процесс в ps.
# Аргументы: tg_curl_to FILE URL [доп. аргументы curl...]
tg_curl_to(){
	_tg_out="$1"; _tg_url="$2"; shift 2
	rm -f "${_tg_out}" 2>/dev/null
	_p=$(tg_socks_port)
	[ -n "${_p}" ] || _p=1097
	curl -s --max-time "${TG_CURL_MAX:-15}" -o "${_tg_out}" "$@" -x "socks5h://127.0.0.1:${_p}" "${_tg_url}" 2>/dev/null
	[ -s "${_tg_out}" ] && return 0
	for _q in 1097 10808 10818; do
		[ "${_q}" = "${_p}" ] && continue
		curl -s --max-time "${TG_CURL_MAX:-12}" -o "${_tg_out}" "$@" -x "socks5h://127.0.0.1:${_q}" "${_tg_url}" 2>/dev/null
		[ -s "${_tg_out}" ] && return 0
	done
	curl -s --max-time "${TG_CURL_MAX:-12}" -o "${_tg_out}" "$@" "${_tg_url}" 2>/dev/null
	[ -s "${_tg_out}" ]
}

tg_notify(){
	# $1 = код события, $2 = текст
	[ "$(tg_conf_get TG_ENABLED)" = "true" ] || return 0
	# P.8+: только эти события; остальные хуки в коде гасятся здесь
	case "$1" in
		failover|update_found|tunnel|health|parental_expire) ;;
		*) return 0 ;;
	esac
	_tg_t=$(tg_conf_get TG_BOT_TOKEN); _tg_c=$(tg_conf_get TG_CHAT_ID)
	[ -n "${_tg_t}" ] && [ -n "${_tg_c}" ] || return 0
	_tg_ev=$(tg_conf_get TG_EVENTS); [ -n "${_tg_ev}" ] || _tg_ev=all
	case ",${_tg_ev}," in
		*,none,*) return 0 ;;
		*,all,*|*,"$1",*) ;;
		*) return 0 ;;
	esac
	# тихие часы: событие кладём в очередь, но сразу не шлём (sender ждёт окна)
	mkdir -p "${TG_QUEUE_DIR}" 2>/dev/null || return 0
	_tg_txt=$(printf '%s' "$2" | tr '\r\n\t' '   ')
	printf '%s\t%s\n' "$1" "${_tg_txt}" >> "${TG_QUEUE}" 2>/dev/null
	if tg_quiet_active; then
		return 0
	fi
	( sh /opt/apps/kvas/bin/tg_sender.sh >/dev/null 2>&1 & ) 2>/dev/null
	return 0
}

# sendMessage: $1=chat $2=text [$3=reply_markup JSON]
# fire-and-forget через tg_curl_to; return 0 только при "ok":true в ответе
tg_send_msg(){
	_t_s=$(tg_conf_get TG_BOT_TOKEN)
	[ -n "${_t_s}" ] || return 1
	_tf="/tmp/.tgs.$$"
	if [ -n "$3" ]; then
		tg_curl_to "${_tf}" "https://api.telegram.org/bot${_t_s}/sendMessage" \
			--data-urlencode "chat_id=$1" \
			--data-urlencode "text=$2" \
			--data-urlencode "reply_markup=$3" 2>/dev/null
	else
		tg_curl_to "${_tf}" "https://api.telegram.org/bot${_t_s}/sendMessage" \
			--data-urlencode "chat_id=$1" \
			--data-urlencode "text=$2" 2>/dev/null
	fi
	_tg_ok=1
	[ -s "${_tf}" ] && grep -q '"ok":true' "${_tf}" 2>/dev/null && _tg_ok=0
	[ "${_tg_ok}" -ne 0 ] && [ -s "${_tf}" ] && {
		# короткий хвост ответа в stderr → уйдёт в лог бота/демона
		printf 'tg_send_fail: %s\n' "$(tail -c 200 "${_tf}" 2>/dev/null | tr '\n' ' ')" >&2
	}
	rm -f "${_tf}" 2>/dev/null
	return ${_tg_ok}
}

# длинный текст → чанки ~3500 байт по строкам: $1=chat $2=text [$3=markup только для первого]
tg_send_long(){
	_tl_ch="$1"; _tl_txt="$2"; _tl_mk="$3"
	_tl_f=/tmp/.tglong.$$
	printf '%s\n' "${_tl_txt}" > "${_tl_f}" 2>/dev/null || return 0
	_tl_buf=""
	while IFS= read -r _tl_line || [ -n "${_tl_line}" ]; do
		_tl_bl=$(printf '%s' "${_tl_buf}" | wc -c)
		_tl_ll=$(printf '%s' "${_tl_line}" | wc -c)
		if [ -n "${_tl_buf}" ] && [ $((_tl_bl + _tl_ll + 1)) -gt 3500 ]; then
			tg_send_msg "${_tl_ch}" "${_tl_buf}" "${_tl_mk}"
			_tl_mk=""
			_tl_buf="${_tl_line}"
			sleep 1
		else
			if [ -n "${_tl_buf}" ]; then
				_tl_buf="${_tl_buf}
${_tl_line}"
			else
				_tl_buf="${_tl_line}"
			fi
		fi
	done < "${_tl_f}"
	rm -f "${_tl_f}"
	[ -n "${_tl_buf}" ] && tg_send_msg "${_tl_ch}" "${_tl_buf}" "${_tl_mk}"
	return 0
}

# Проверка новой версии KVAS на GitHub + update_found (dedup через tg.lastupd).
# Возвращает available:vN | up_to_date (для Web UI и фонового чека).
tg_check_kvas_update(){
	_cur=$(opkg list-installed 2>/dev/null | grep kvas | awk '{print $3}')
	_cur_num=$(printf '%s' "${_cur}" | sed 's/.*beta-10-//')
	[ -n "${_cur_num}" ] || _cur_num=$(sed -n 's/^APP_RELEASE=//p' /opt/etc/kvas.conf 2>/dev/null | head -1)
	_lat=$(curl -s --connect-timeout 5 --max-time 10 "https://api.github.com/repos/Anonimus2026/kvas/releases" 2>/dev/null | \
		grep -o 'kvas_[A-Za-z0-9._-]*_all\.ipk' | \
		sed -n 's/.*beta-10-\([0-9][0-9]*\)_all\.ipk/\1/p' | \
		sort -n | tail -1)
	if [ -n "${_lat}" ] && [ -n "${_cur_num}" ] && [ "${_lat}" -gt "${_cur_num}" ] 2>/dev/null; then
		mkdir -p /opt/var/kvas 2>/dev/null
		_tg_lu=/opt/var/kvas/tg.lastupd
		if [ "$(cat "${_tg_lu}" 2>/dev/null)" != "v${_lat}" ]; then
			tg_notify update_found "Доступно обновление KVAS v${_lat} (у вас сборка ${_cur_num})"
			echo "v${_lat}" > "${_tg_lu}" 2>/dev/null
		fi
		echo "available:v${_lat}"
	else
		echo "up_to_date"
	fi
}
