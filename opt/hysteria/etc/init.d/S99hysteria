#!/bin/sh
ENABLED=yes
PROG="/opt/bin/hysteria"
CONF="/opt/etc/hysteria/config.yaml"
ARGS="client -c $CONF"
PIDFILE="/var/run/hysteria.pid"
LOGFILE="/var/log/hysteria.log"

WATCHDOG_PROG="/opt/apps/kvas/hysteria/etc/ndm/watchdog.sh"
WATCHDOG_PID="/var/run/hysteria-watchdog.pid"
ACTIVE_FLAG="/var/run/hysteria.active"

case "$1" in
    start)
        # v667: «Стоп» (веб/CLI) должен пережить перезагрузку — флаг выключения
        [ -f /opt/var/kvas/svc.hysteria.disabled ] && { echo "Hysteria выключена пользователем — автозапуск пропущен"; exit 0; }
        [ "$ENABLED" != "yes" ] && exit 0
        if [ ! -f "$CONF" ]; then
            echo "Конфигурация $CONF не найдена. Сначала выполните: kvas hysteria new"
            exit 1
        fi
        if [ ! -x "$PROG" ]; then
            echo "Hysteria не запущена: бинарник $PROG отсутствует. Выполните: kvas hysteria install"
            exit 1
        fi
        # v675: сирота — живой hysteria при мёртвом/удалённом pidfile. Такое
        # случается после гонок рестартов (веб + watchdog): порт 10808 занят,
        # новый старт падал с FATAL «bind: address already in use», а статус
        # при этом врал «Остановлена». Убиваем сироту до bind.
        if ! { [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; }; then
            _orph=$(pidof hysteria 2>/dev/null)
            if [ -n "$_orph" ]; then
                echo "Найдена сирота Hysteria (pid: $_orph) — убиваю для освобождения порта."
                kill $_orph 2>/dev/null
                sleep 1
            fi
        fi
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
            echo "Hysteria уже запущена."
        else
            $PROG $ARGS > "$LOGFILE" 2>&1 &
            echo $! > "$PIDFILE"
            touch "$ACTIVE_FLAG"
            sleep 1
            if ! kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
                echo "Hysteria не запустилась (упала на старте - проверьте config.yaml)."
                echo "Последние строки журнала ($LOGFILE):"
                tail -n 10 "$LOGFILE" 2>/dev/null
                rm -f "$PIDFILE"
                exit 1
            fi
            echo "Hysteria успешно запущена."
        fi

        # Запуск фонового мониторинга
        if [ -x "$WATCHDOG_PROG" ]; then
            if [ ! -f "$WATCHDOG_PID" ] || ! kill -0 "$(cat "$WATCHDOG_PID" 2>/dev/null)" 2>/dev/null; then
                "$WATCHDOG_PROG" >/dev/null 2>&1 &
                echo $! > "$WATCHDOG_PID"
            fi
        fi
        ;;
    stop)
        # 1. Принудительная остановка мониторинга
        # v674: killall watchdog.sh убивал И чужой watchdog (awg) — при любом
        # рестарте Hysteria мониторинг соседа гиб молча. Свой — только по pidfile;
        # чужой переживёт рестарт и сам завершится по своему ACTIVE_FLAG (≤35с)
        rm -f "$ACTIVE_FLAG"
        if [ -f "$WATCHDOG_PID" ]; then
            # v675: рестарт по инициативе самого watchdog'а — pidfile содержит
            # наш же pid ($$), kill оборвал бы stop между stop и start
            # (hysteria убита, pidfile не удалён, мониторинг сиротеет)
            _wpid=$(cat "$WATCHDOG_PID" 2>/dev/null)
            [ -n "$_wpid" ] && [ "$_wpid" != "$$" ] && kill "$_wpid" 2>/dev/null
            rm -f "$WATCHDOG_PID"
        fi

        # 2. Остановка основного демона Hysteria
        if [ -f "$PIDFILE" ]; then
            kill "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
            rm -f "$PIDFILE"
            echo "Hysteria остановлена."
        else
            killall hysteria 2>/dev/null
            echo "Hysteria не была запущена."
        fi
        ;;
    restart)
        $0 stop && sleep 2 && $0 start
        ;;
    status)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
            echo "Hysteria запущена (PID: $(cat "$PIDFILE"))."
            if [ -f "$WATCHDOG_PID" ] && kill -0 "$(cat "$WATCHDOG_PID" 2>/dev/null)" 2>/dev/null; then
                echo "Мониторинг активен (PID: $(cat "$WATCHDOG_PID"))."
            else
                echo "Мониторинг не активен."
            fi
            exit 0
        else
            echo "Hysteria остановлена."
            exit 1
        fi
        ;;
    *)
        echo "Использование: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
