
{
    "log": {
        "access": "/tmp/log/xray-access.log",
        "error": "/tmp/log/xray-errors.log",
        "loglevel": "error"
    },
    "routing": {
        "rules": [],
        "domainStrategy": "AsIs"
    },
    "inbounds": [
        {
            "listen": "127.0.0.1",
            "port":  @VLESS_SSR_PORT,
            "protocol": "socks",
            "settings": {
                "udp": true
            }
        }
    ],
    "outbounds": [
        {
            "tag": "vless",
            "protocol": "vless",
            "settings": {
                "vnext": [
                    {
                        "address": "@VLESS_ADDRESS",
                        "port": @VLESS_PORT,
                        "users": [
                            {
                                "id": "@VLESS_ID",
                                @VLESS_FLOW_FIELD
                                "encryption": "none"
                            }
                        ]
                    }
                ]
            },
            "streamSettings": {
                "network": "@VLESS_NETWORK",
                "security": "@VLESS_SECURITY",
                @VLESS_STREAM_SETTINGS
            }
        }
    ]
}
